diff --git a/linux/include/remix_linux_compat.h b/linux/include/remix_linux_compat.h
index 8e47caa..4caa926 100644
--- a/linux/include/remix_linux_compat.h
+++ b/linux/include/remix_linux_compat.h
@@ -316,6 +316,7 @@ typedef struct _devicemodeW {
   DWORD dmDisplayFrequency;
 } DEVMODEW, *PDEVMODEW, *LPDEVMODEW;
 
+#define DM_INTERLACED       0x00000002
 #define DM_BITSPERPEL       0x00040000
 #define DM_PELSWIDTH        0x00080000
 #define DM_PELSHEIGHT       0x00100000
@@ -741,3 +742,172 @@ inline HANDLE CreateEventA(void*, BOOL, BOOL, const char*) {
 inline DWORD WaitForSingleObject(HANDLE, DWORD) {
   return WAIT_FAILED;
 }
+
+// Display enumeration reports a single primary display, which the D3D9 adapter list expects to exist.
+#define DISPLAY_DEVICE_ATTACHED_TO_DESKTOP 0x00000001
+#define DISPLAY_DEVICE_MIRRORING_DRIVER    0x00000008
+#define DISPLAY_DEVICE_PRIMARY_DEVICE      0x00000004
+typedef struct _DISPLAY_DEVICEA {
+  DWORD cb;
+  CHAR  DeviceName[32];
+  CHAR  DeviceString[128];
+  DWORD StateFlags;
+  CHAR  DeviceID[128];
+  CHAR  DeviceKey[128];
+} DISPLAY_DEVICEA, *PDISPLAY_DEVICEA;
+
+inline BOOL EnumDisplayDevicesA(const char*, DWORD index, DISPLAY_DEVICEA* device, DWORD) {
+  if (device == nullptr || index != 0) {
+    return FALSE;
+  }
+  const DWORD cb = device->cb;
+  std::memset(device, 0, sizeof(*device));
+  device->cb = cb;
+  std::snprintf(device->DeviceName, sizeof(device->DeviceName), "\\\\.\\DISPLAY1");
+  std::snprintf(device->DeviceString, sizeof(device->DeviceString), "Headless display");
+  device->StateFlags = DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE;
+  return TRUE;
+}
+
+// Cursor and GDI device-context functions. The headless runtime has neither.
+inline BOOL GetCursorPos(POINT* pt) {
+  if (pt) {
+    *pt = POINT { 0, 0 };
+  }
+  return TRUE;
+}
+
+inline BOOL SetCursorPos(int, int) {
+  return TRUE;
+}
+
+inline HCURSOR SetCursor(HCURSOR) {
+  return nullptr;
+}
+
+inline HDC CreateCompatibleDC(HDC) {
+  return nullptr;
+}
+
+inline BOOL DeleteDC(HDC) {
+  return TRUE;
+}
+
+// Only the null handles returned by the event stubs above reach this. FD-backed handles are closed explicitly with close().
+inline BOOL CloseHandle(HANDLE handle) {
+  return handle == nullptr || handle == INVALID_HANDLE_VALUE;
+}
+
+// Window management. The headless runtime's window handle is only a token, so placement and style
+// changes do nothing, and geometry queries report the client size the API has set.
+#define GWL_STYLE   (-16)
+#define GWL_EXSTYLE (-20)
+#define WS_VISIBLE             0x10000000L
+#define WS_OVERLAPPEDWINDOW    0x00CF0000L
+#define WS_EX_TOPMOST          0x00000008L
+#define WS_EX_OVERLAPPEDWINDOW 0x00000300L
+#define SWP_NOSIZE         0x0001
+#define SWP_NOMOVE         0x0002
+#define SWP_NOZORDER       0x0004
+#define SWP_NOACTIVATE     0x0010
+#define SWP_FRAMECHANGED   0x0020
+#define SWP_SHOWWINDOW     0x0040
+#define SWP_ASYNCWINDOWPOS 0x4000
+#define HWND_TOP       ((HWND)0)
+#define HWND_DESKTOP   ((HWND)0)
+#define HWND_TOPMOST   ((HWND)-1)
+#define HWND_NOTOPMOST ((HWND)-2)
+#define SM_CXSCREEN 0
+#define SM_CYSCREEN 1
+#define WM_NULL           0x0000
+#define WM_DESTROY        0x0002
+#define WM_SIZE           0x0005
+#define WM_ACTIVATE       0x0006
+#define WM_SETFOCUS       0x0007
+#define WM_KILLFOCUS      0x0008
+#define WM_ACTIVATEAPP    0x001C
+#define WM_ENDSESSION     0x0016
+#define WM_WINDOWPOSCHANGING 0x0046
+#define WM_WINDOWPOSCHANGED  0x0047
+#define WM_NCCALCSIZE     0x0083
+#define WM_NCDESTROY      0x0082
+#define WM_ENTERMENULOOP  0x0211
+#define WM_EXITMENULOOP   0x0212
+#define WA_INACTIVE    0
+#define SIZE_RESTORED  0
+#define SIZE_MINIMIZED 1
+
+inline BOOL IsWindow(HWND window) {
+  return window != nullptr;
+}
+
+inline HWND GetParent(HWND) {
+  return nullptr;
+}
+
+inline LONG GetWindowLongA(HWND, int) {
+  return WS_VISIBLE;
+}
+
+inline LONG GetWindowLongW(HWND window, int index) {
+  return GetWindowLongA(window, index);
+}
+
+inline LONG SetWindowLongA(HWND, int, LONG) {
+  return 0;
+}
+
+inline LONG SetWindowLongW(HWND window, int index, LONG value) {
+  return SetWindowLongA(window, index, value);
+}
+
+#define GetWindowLong GetWindowLongA
+#define SetWindowLong SetWindowLongA
+
+inline BOOL SetWindowPos(HWND, HWND, int, int, int, int, UINT) {
+  return TRUE;
+}
+
+inline BOOL GetWindowRect(HWND window, RECT* rect) {
+  return GetClientRect(window, rect);
+}
+
+inline int MapWindowPoints(HWND, HWND, POINT*, UINT) {
+  return 0;
+}
+
+inline BOOL SetRect(RECT* rect, int left, int top, int right, int bottom) {
+  if (rect == nullptr) {
+    return FALSE;
+  }
+  rect->left = left;
+  rect->top = top;
+  rect->right = right;
+  rect->bottom = bottom;
+  return TRUE;
+}
+
+inline BOOL OffsetRect(RECT* rect, int dx, int dy) {
+  if (rect == nullptr) {
+    return FALSE;
+  }
+  rect->left += dx;
+  rect->right += dx;
+  rect->top += dy;
+  rect->bottom += dy;
+  return TRUE;
+}
+
+inline BOOL AdjustWindowRectEx(RECT*, DWORD, BOOL, DWORD) {
+  return TRUE;
+}
+
+inline int GetSystemMetrics(int index) {
+  RECT rect = {};
+  GetClientRect(nullptr, &rect);
+  return index == SM_CXSCREEN ? rect.right : index == SM_CYSCREEN ? rect.bottom : 0;
+}
+
+inline BOOL PostMessageW(HWND, UINT, WPARAM, LPARAM) {
+  return FALSE;
+}
