+// Platform extension provider for the headless Linux runtime, replacing platform/dxvk_win32_exts.cpp.
+// The runtime never creates a window surface, so it requests no WSI platform extension.
+// VK_KHR_win32_surface in particular does not exist on Linux and would fail instance creation.
+
+#include "../../src/dxvk/dxvk_platform_exts.h"
+
+namespace dxvk {
+  DxvkPlatformExts DxvkPlatformExts::s_instance;
+
+  std::string_view DxvkPlatformExts::getName() {
+    return "Headless (Linux)";
+  }
+
+  DxvkNameSet DxvkPlatformExts::getInstanceExtensions() {
+    return DxvkNameSet();
+  }
+
+  DxvkNameSet DxvkPlatformExts::getDeviceExtensions(uint32_t) {
+    return DxvkNameSet();
+  }
+
+  void DxvkPlatformExts::initInstanceExtensions() { }
+
+  void DxvkPlatformExts::initDeviceExtensions(const DxvkInstance*) { }
+}
