+// Replacements for the USD-based implementation files the native Linux build compiles out
+// (rtx_mod_usd.cpp, rtx_game_capturer.cpp, rtx_graph_usd_parser.cpp, dxvk_imgui_capture.cpp).
+// USD mods are never discovered, and the capture menu reports that capture is unavailable.
+
+#include "../../src/dxvk/rtx_render/rtx_mod_usd.h"
+#include "../../src/dxvk/imgui/dxvk_imgui_capture.h"
+#include "../../src/dxvk/imgui/imgui.h"
+
+namespace dxvk {
+  namespace {
+    struct NoUsdModTypeInfo final : public ModTypeInfo {
+      std::unique_ptr<Mod> construct(const Mod::Path&) const override {
+        return nullptr;
+      }
+
+      bool isValidMod(const Mod::Path&) const override {
+        return false;
+      }
+    };
+  }
+
+  const ModTypeInfo& UsdMod::getTypeInfo() {
+    static NoUsdModTypeInfo s_typeInfo;
+    return s_typeInfo;
+  }
+
+  void ImGuiCapture::update(const Rc<DxvkContext>&) { }
+
+  void ImGuiCapture::show(const Rc<DxvkContext>&) {
+    ImGui::TextDisabled("USD scene capture is not available in the Linux build.");
+  }
+
+  ImGuiCapture::StageNameInputBox::StageNameInputBox() {
+    m_buf[0] = '\0';
+  }
+}
diff --git a/linux/stubs/remix_linux_stubs.cpp b/linux/stubs/remix_linux_stubs.cpp
index 1ea9610..c0da017 100644
--- a/linux/stubs/remix_linux_stubs.cpp
+++ b/linux/stubs/remix_linux_stubs.cpp
@@ -28,6 +28,9 @@
 
 #include <NrcVk.h>
 #include <nvapi.h>
+#include <xess/xess.h>
+#include <xess/xess_vk.h>
+#include <xess/xess_debug.h>
 
 // Neural Radiance Cache (submodules/nrc ships Windows binaries only).
 namespace nrc {
@@ -149,3 +152,68 @@ extern "C" {
     return NVAPI_API_NOT_INITIALIZED;
   }
 }
+
+// Intel XeSS ships Windows libraries only. Context creation fails, so the upscaler is unavailable.
+extern "C" {
+  xess_result_t xessGetVersion(xess_version_t* pVersion) {
+    if (pVersion) {
+      *pVersion = xess_version_t {};
+    }
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessVKCreateContext(VkInstance, VkPhysicalDevice, VkDevice, xess_context_handle_t* phContext) {
+    if (phContext) {
+      *phContext = nullptr;
+    }
+    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
+  }
+
+  xess_result_t xessVKBuildPipelines(xess_context_handle_t, VkPipelineCache, bool, uint32_t) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessVKInit(xess_context_handle_t, const xess_vk_init_params_t*) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessVKExecute(xess_context_handle_t, VkCommandBuffer, const xess_vk_execute_params_t*) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessGetOptimalInputResolution(xess_context_handle_t, const xess_2d_t*, xess_quality_settings_t,
+                                              xess_2d_t*, xess_2d_t*, xess_2d_t*) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessGetJitterScale(xess_context_handle_t, float* pX, float* pY) {
+    if (pX) {
+      *pX = 1.0f;
+    }
+    if (pY) {
+      *pY = 1.0f;
+    }
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessDestroyContext(xess_context_handle_t) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessSetMaxResponsiveMaskValue(xess_context_handle_t, float) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessIsOptimalDriver(xess_context_handle_t) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  xess_result_t xessSelectNetworkModel(xess_context_handle_t, xess_network_model_t) {
+    return XESS_RESULT_ERROR_UNSUPPORTED;
+  }
+
+  // Declared in src/d3d9/d3d9_include.h. DPI awareness is a Win32 process setting.
+  WINBOOL SetProcessDPIAware(void) {
+    return TRUE;
+  }
+}
