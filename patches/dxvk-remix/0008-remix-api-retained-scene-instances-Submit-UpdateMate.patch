+bool AssetReplacer::updateExternalMaterial(remixapi_MaterialHandle handle, MaterialData&& data) {
+  auto found = m_extMaterials.find(handle);
+  if (found == m_extMaterials.end()) {
+    m_extMaterials.emplace(handle, std::move(data));
+    return false;
+  }
+  found->second = std::move(data);
+  return true;
+}
