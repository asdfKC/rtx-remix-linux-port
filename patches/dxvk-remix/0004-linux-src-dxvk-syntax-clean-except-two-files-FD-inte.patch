+// Headless ImGui platform backend for the native Linux runtime. It implements the entry points of
+// imgui_impl_win32.cpp that the runtime calls. There is no native window, so the display size is the client
+// size the Remix API reports, and input arrives through ImGui's AddKeyEvent/AddMouse* functions.
+// The key mapping below is copied unchanged from imgui_impl_win32.cpp (Dear ImGui, MIT license).
+
+#include "../../src/dxvk/imgui/imgui.h"
+#include "../../src/dxvk/imgui/imgui_impl_win32.h"
+#include "../../src/util/util_monitor.h"
+
+#include <chrono>
+
+namespace {
+  struct HeadlessBackendData {
+    std::chrono::steady_clock::time_point lastTime;
+  };
+
+  HeadlessBackendData* getBackendData() {
+    return ImGui::GetCurrentContext() ? static_cast<HeadlessBackendData*>(ImGui::GetIO().BackendPlatformUserData) : nullptr;
+  }
+}
+
+bool ImGui_ImplWin32_Init(void*) {
+  ImGuiIO& io = ImGui::GetIO();
+  IM_ASSERT(io.BackendPlatformUserData == nullptr && "Already initialized a platform backend!");
+  HeadlessBackendData* bd = IM_NEW(HeadlessBackendData)();
+  bd->lastTime = std::chrono::steady_clock::now();
+  io.BackendPlatformUserData = bd;
+  io.BackendPlatformName = "remix_headless_linux";
+  return true;
+}
+
+void ImGui_ImplWin32_Shutdown() {
+  HeadlessBackendData* bd = getBackendData();
+  if (bd == nullptr) {
+    return;
+  }
+  ImGuiIO& io = ImGui::GetIO();
+  io.BackendPlatformName = nullptr;
+  io.BackendPlatformUserData = nullptr;
+  IM_DELETE(bd);
+}
+
+void ImGui_ImplWin32_NewFrame() {
+  HeadlessBackendData* bd = getBackendData();
+  IM_ASSERT(bd != nullptr && "Did you call ImGui_ImplWin32_Init()?");
+  ImGuiIO& io = ImGui::GetIO();
+
+  UINT width = 0;
+  UINT height = 0;
+  dxvk::GetWindowClientSize(nullptr, &width, &height);
+  io.DisplaySize = ImVec2(static_cast<float>(width), static_cast<float>(height));
+
+  const auto now = std::chrono::steady_clock::now();
+  const float dt = std::chrono::duration<float>(now - bd->lastTime).count();
+  io.DeltaTime = dt > 0.0f ? dt : 1.0f / 60.0f;
+  bd->lastTime = now;
+}
+
+LRESULT ImGui_ImplWin32_WndProcHandler(HWND, UINT, WPARAM, LPARAM) {
+  return 0;
+}
+
+void ImGui_ImplWin32_EnableDpiAwareness() { }
+
+float ImGui_ImplWin32_GetDpiScaleForHwnd(void*) {
+  return 1.0f;
+}
+
+float ImGui_ImplWin32_GetDpiScaleForMonitor(void*) {
+  return 1.0f;
+}
+
+void ImGui_ImplWin32_EnableAlphaCompositing(void*) { }
+
