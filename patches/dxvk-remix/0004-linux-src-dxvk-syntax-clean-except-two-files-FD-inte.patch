+// Message boxes are reported on stderr. The runtime only uses them for fatal or blocking notices.
+#define MB_OK              0x00000000L
+#define MB_OKCANCEL        0x00000001L
+#define MB_YESNO           0x00000004L
+#define MB_ICONHAND        0x00000010L
+#define MB_ICONSTOP        MB_ICONHAND
+#define MB_ICONERROR       MB_ICONHAND
+#define MB_ICONQUESTION    0x00000020L
+#define MB_ICONEXCLAMATION 0x00000030L
+#define MB_ICONWARNING     MB_ICONEXCLAMATION
+#define MB_ICONINFORMATION 0x00000040L
+#define MB_TOPMOST         0x00040000L
+#define MB_SETFOREGROUND   0x00010000L
+#define MB_SYSTEMMODAL     0x00001000L
+#define IDOK     1
+#define IDCANCEL 2
+#define IDYES    6
+#define IDNO     7
+
+inline int MessageBoxA(HWND, const char* text, const char* caption, UINT) {
+  std::fprintf(stderr, "[RTX Remix] %s: %s\n", caption ? caption : "", text ? text : "");
+  return IDOK;
+}
+
+inline int MessageBoxW(HWND hwnd, const wchar_t* text, const wchar_t* caption, UINT type) {
+  char t[4096] = {};
+  char c[512] = {};
+  remix_linux::wideToUtf8(text, -1, t, sizeof(t) - 1);
+  remix_linux::wideToUtf8(caption, -1, c, sizeof(c) - 1);
+  return MessageBoxA(hwnd, t, c, type);
+}
+
+#define MessageBox MessageBoxA
+
+// Returns the process command line with arguments separated by spaces.
+inline const char* GetCommandLineA() {
+  static std::string commandLine = [] {
+    std::string result;
+    if (FILE* f = std::fopen("/proc/self/cmdline", "rb")) {
+      int ch;
+      while ((ch = std::fgetc(f)) != EOF) {
+        result.push_back(ch == 0 ? ' ' : static_cast<char>(ch));
+      }
+      std::fclose(f);
+    }
+    while (!result.empty() && result.back() == ' ') {
+      result.pop_back();
+    }
+    return result;
+  }();
+  return commandLine.c_str();
+}
+
+// Reports whether a tracer (gdb, strace) is attached, from /proc/self/status.
+inline BOOL IsDebuggerPresent() {
+  FILE* f = std::fopen("/proc/self/status", "r");
+  if (f == nullptr) {
+    return FALSE;
+  }
+  char line[256];
+  int tracer = 0;
+  while (std::fgets(line, sizeof(line), f)) {
+    if (std::strncmp(line, "TracerPid:", 10) == 0) {
+      tracer = std::atoi(line + 10);
+      break;
+    }
+  }
+  std::fclose(f);
+  return tracer != 0;
+}
+
+// The headless runtime has no OS cursor. ShowCursor keeps the Win32 display counter semantics.
+inline int ShowCursor(BOOL show) {
+  static int counter = 0;
+  counter += show ? 1 : -1;
+  return counter;
+}
+
+// The headless runtime treats the host process as the foreground application.
+inline HWND GetForegroundWindow() {
+  return reinterpret_cast<HWND>(1);
+}
+
+inline DWORD GetWindowThreadProcessId(HWND, DWORD* processId) {
+  if (processId) {
+    *processId = GetCurrentProcessId();
+  }
+  return GetCurrentThreadId();
+}
+
+// The registry does not exist on Linux. Every call fails, so registry-driven features (OpenVR via Wine) stay off.
+typedef LONG LSTATUS;
+#define ERROR_SUCCESS        0L
+#define ERROR_FILE_NOT_FOUND 2L
+#define HKEY_CLASSES_ROOT  ((HKEY)(ULONG_PTR)((LONG)0x80000000))
+#define HKEY_CURRENT_USER  ((HKEY)(ULONG_PTR)((LONG)0x80000001))
+#define HKEY_LOCAL_MACHINE ((HKEY)(ULONG_PTR)((LONG)0x80000002))
+#define KEY_READ 0x20019
+#define REG_NOTIFY_CHANGE_LAST_SET 0x00000004L
+typedef BYTE* PBYTE;
+typedef BYTE* LPBYTE;
+
+inline LSTATUS RegOpenKeyExA(HKEY, const char*, DWORD, DWORD, HKEY* result) {
+  if (result) {
+    *result = nullptr;
+  }
+  return ERROR_FILE_NOT_FOUND;
+}
+
+inline LSTATUS RegQueryValueExA(HKEY, const char*, DWORD*, DWORD*, BYTE*, DWORD*) {
+  return ERROR_FILE_NOT_FOUND;
+}
+
+inline LSTATUS RegNotifyChangeKeyValue(HKEY, BOOL, DWORD, HANDLE, BOOL) {
+  return ERROR_FILE_NOT_FOUND;
+}
+
+inline LSTATUS RegCloseKey(HKEY) {
+  return ERROR_SUCCESS;
+}
+
+typedef HANDLE HCURSOR;
+typedef HANDLE HICON;
+typedef HANDLE HBITMAP;
+
+// Client area of a window. The headless runtime reports the size the API has set.
+inline BOOL GetClientRect(HWND, RECT* rect) {
+  extern void remix_linux_getHeadlessClientSize(uint32_t* width, uint32_t* height);
+  if (rect == nullptr) {
+    return FALSE;
+  }
+  uint32_t w = 0;
+  uint32_t h = 0;
+  remix_linux_getHeadlessClientSize(&w, &h);
+  rect->left = 0;
+  rect->top = 0;
+  rect->right = static_cast<LONG>(w);
+  rect->bottom = static_cast<LONG>(h);
+  return TRUE;
+}
+
+// The headless runtime does not own the OS cursor. Positions are left unchanged.
+#define CURSOR_SHOWING 0x00000001
+typedef struct tagCURSORINFO {
+  DWORD   cbSize;
+  DWORD   flags;
+  HCURSOR hCursor;
+  POINT   ptScreenPos;
+} CURSORINFO, *PCURSORINFO;
+
+inline BOOL GetCursorInfo(CURSORINFO* info) {
+  if (info == nullptr) {
+    return FALSE;
+  }
+  info->flags = CURSOR_SHOWING;
+  info->hCursor = nullptr;
+  info->ptScreenPos = POINT { 0, 0 };
+  return TRUE;
+}
+
+inline BOOL GetPhysicalCursorPos(POINT* pt) {
+  if (pt) {
+    *pt = POINT { 0, 0 };
+  }
+  return TRUE;
+}
+
+inline BOOL SetPhysicalCursorPos(int, int) {
+  return TRUE;
+}
+
+inline int _stricmp(const char* a, const char* b) {
+  return ::strcasecmp(a, b);
+}
+
+inline int _strnicmp(const char* a, const char* b, size_t n) {
+  return ::strncasecmp(a, b, n);
+}
+
+// Win32 events used by the OpenVR registry watcher, which never runs on Linux.
+#define REG_DWORD 4
+#define INFINITE 0xFFFFFFFF
+
+inline HANDLE CreateEventA(void*, BOOL, BOOL, const char*) {
+  return nullptr;
+}
+
+inline DWORD WaitForSingleObject(HANDLE, DWORD) {
+  return WAIT_FAILED;
+}
