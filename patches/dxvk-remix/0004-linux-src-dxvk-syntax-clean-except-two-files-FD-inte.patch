+      const uint64_t totalPhys = uint64_t(memInfo.totalram) * unit;
+      const uint64_t availPhys = uint64_t(memInfo.freeram + memInfo.bufferram) * unit;
+      const uint64_t totalSwap = uint64_t(memInfo.totalswap) * unit;
+      const uint64_t freeSwap = uint64_t(memInfo.freeswap) * unit;
+
+      sentry::setTag("ram", str::formatBytes(static_cast<size_t>(totalPhys)));
+      const std::string memoryLine = str::format(
