+        str::formatBytes(totalSwap >= freeSwap ? totalSwap - freeSwap : 0), " / ", str::formatBytes(totalSwap), " swap"
+      );
+      Logger::info(memoryLine);
+      sentry::setContext("system_info_memory", memoryLine);
+    } else {
+      Logger::warn("Unable to get system memory information.");
+    }
+
+    struct utsname name = {};
