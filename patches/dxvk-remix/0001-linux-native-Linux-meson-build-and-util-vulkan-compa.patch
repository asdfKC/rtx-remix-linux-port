+
+  bool setSharedMetadata(HANDLE, void*, uint32_t) {
+    return false;
+  }
+
+  bool getSharedMetadata(HANDLE, void*, uint32_t, uint32_t*) {
+    return false;
+  }
+
+  // util_monitor
+  HMONITOR GetDefaultMonitor() {
+    return reinterpret_cast<HMONITOR>(1);
+  }
+
+  BOOL SetMonitorDisplayMode(HMONITOR, DEVMODEW*) {
+    return FALSE;
+  }
+
+  BOOL GetMonitorDisplayMode(HMONITOR, DWORD modeNum, DEVMODEW* pMode) {
+    if (pMode == nullptr || (modeNum != ENUM_CURRENT_SETTINGS && modeNum != ENUM_REGISTRY_SETTINGS && modeNum != 0)) {
+      return FALSE;
+    }
+    pMode->dmPelsWidth = remix_linux::g_clientWidth;
+    pMode->dmPelsHeight = remix_linux::g_clientHeight;
+    pMode->dmBitsPerPel = 32;
+    pMode->dmDisplayFrequency = 60;
+    return TRUE;
+  }
+
+  BOOL RestoreMonitorDisplayMode() {
+    return TRUE;
+  }
+
+  void GetWindowClientSize(HWND, UINT* pWidth, UINT* pHeight) {
+    if (pWidth) {
+      *pWidth = remix_linux::g_clientWidth;
+    }
+    if (pHeight) {
+      *pHeight = remix_linux::g_clientHeight;
+    }
+  }
+
+  void GetMonitorClientSize(HMONITOR, UINT* pWidth, UINT* pHeight) {
+    GetWindowClientSize(nullptr, pWidth, pHeight);
+  }
+
+  void GetMonitorRect(HMONITOR, RECT* pRect) {
+    if (pRect) {
+      pRect->left = 0;
+      pRect->top = 0;
+      pRect->right = static_cast<LONG>(remix_linux::g_clientWidth.load());
+      pRect->bottom = static_cast<LONG>(remix_linux::g_clientHeight.load());
+    }
+  }
