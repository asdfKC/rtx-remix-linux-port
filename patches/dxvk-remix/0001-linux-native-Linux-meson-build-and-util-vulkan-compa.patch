+namespace remix_linux {
+  // Converts between UTF-8 and the 32-bit wchar_t used on Linux.
+  // Both functions follow the Win32 contract: a length of -1 includes the terminator,
+  // and a zero output size returns the required size.
+  inline int utf8ToWide(const char* src, int srcLen, wchar_t* dst, int dstLen) {
+    if (src == nullptr) {
+      return 0;
+    }
+    const size_t inLen = srcLen < 0 ? std::strlen(src) + 1 : static_cast<size_t>(srcLen);
+    int count = 0;
+    size_t i = 0;
+    while (i < inLen) {
+      uint32_t c = static_cast<unsigned char>(src[i]);
+      int extra = 0;
+      if (c >= 0xF0) { c &= 0x07; extra = 3; }
+      else if (c >= 0xE0) { c &= 0x0F; extra = 2; }
+      else if (c >= 0xC0) { c &= 0x1F; extra = 1; }
+      i++;
+      for (int k = 0; k < extra && i < inLen; ++k, ++i) {
+        c = (c << 6) | (static_cast<unsigned char>(src[i]) & 0x3F);
+      }
+      if (dstLen > 0) {
+        if (count >= dstLen) {
+          return 0;
+        }
+        dst[count] = static_cast<wchar_t>(c);
+      }
+      count++;
+    }
+    return count;
+  }
+
+  inline int wideToUtf8(const wchar_t* src, int srcLen, char* dst, int dstLen) {
+    if (src == nullptr) {
+      return 0;
+    }
+    const size_t inLen = srcLen < 0 ? std::wcslen(src) + 1 : static_cast<size_t>(srcLen);
+    int count = 0;
+    auto put = [&](char ch) {
+      if (dstLen > 0) {
+        if (count >= dstLen) {
+          return false;
+        }
+        dst[count] = ch;
+      }
+      count++;
+      return true;
+    };
+    for (size_t i = 0; i < inLen; ++i) {
+      const uint32_t c = static_cast<uint32_t>(src[i]);
+      bool ok;
+      if (c < 0x80) {
+        ok = put(static_cast<char>(c));
+      } else if (c < 0x800) {
+        ok = put(static_cast<char>(0xC0 | (c >> 6))) && put(static_cast<char>(0x80 | (c & 0x3F)));
+      } else if (c < 0x10000) {
+        ok = put(static_cast<char>(0xE0 | (c >> 12))) && put(static_cast<char>(0x80 | ((c >> 6) & 0x3F))) && put(static_cast<char>(0x80 | (c & 0x3F)));
+      } else {
+        ok = put(static_cast<char>(0xF0 | (c >> 18))) && put(static_cast<char>(0x80 | ((c >> 12) & 0x3F))) && put(static_cast<char>(0x80 | ((c >> 6) & 0x3F))) && put(static_cast<char>(0x80 | (c & 0x3F)));
+      }
+      if (!ok) {
+        return 0;
+      }
+    }
+    return count;
+  }
+}
+
+inline int WideCharToMultiByte(UINT, DWORD, const wchar_t* src, int srcLen, char* dst, int dstLen, const char*, BOOL*) {
+  return remix_linux::wideToUtf8(src, srcLen, dst, dstLen);
+}
+
+#define MB_ERR_INVALID_CHARS 0x00000008
+
+namespace remix_linux {
+  inline bool isValidUtf8(const char* src, int srcLen) {
+    const size_t len = srcLen < 0 ? std::strlen(src) : static_cast<size_t>(srcLen);
+    size_t i = 0;
+    while (i < len) {
+      const unsigned char c = static_cast<unsigned char>(src[i]);
+      int extra;
+      if (c < 0x80) { extra = 0; }
+      else if ((c & 0xE0) == 0xC0 && c >= 0xC2) { extra = 1; }
+      else if ((c & 0xF0) == 0xE0) { extra = 2; }
+      else if ((c & 0xF8) == 0xF0 && c <= 0xF4) { extra = 3; }
+      else { return false; }
+      for (int k = 1; k <= extra; ++k) {
+        if (i + k >= len || (static_cast<unsigned char>(src[i + k]) & 0xC0) != 0x80) {
+          return false;
+        }
+      }
+      i += extra + 1;
+    }
+    return true;
+  }
+}
+
+inline int MultiByteToWideChar(UINT, DWORD flags, const char* src, int srcLen, wchar_t* dst, int dstLen) {
+  if ((flags & MB_ERR_INVALID_CHARS) && src && !remix_linux::isValidUtf8(src, srcLen)) {
+    errno = EILSEQ;
+    return 0;
+  }
+  return remix_linux::utf8ToWide(src, srcLen, dst, dstLen);
+}
