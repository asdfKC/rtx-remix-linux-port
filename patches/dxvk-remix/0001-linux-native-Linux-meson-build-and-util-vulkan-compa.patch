+  return 1;
+}
+
+inline unsigned char _BitScanReverse(unsigned long* index, unsigned long mask) {
+  if (mask == 0) { return 0; }
+  *index = static_cast<unsigned long>(63 - __builtin_clzl(mask));
+  return 1;
+}
