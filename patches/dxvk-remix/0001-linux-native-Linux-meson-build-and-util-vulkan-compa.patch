+#include <atomic>
+
+namespace remix_linux {
+  static std::atomic<uint32_t> g_clientWidth { 1920 };
+  static std::atomic<uint32_t> g_clientHeight { 1080 };
+
+  void setHeadlessClientSize(uint32_t width, uint32_t height) {
+    if (width != 0 && height != 0) {
+      g_clientWidth = width;
+      g_clientHeight = height;
+    }
+  }
+}
+
+namespace dxvk {
+  // util_shared_res: Windows kernel-mode shared resources do not exist on Linux.
+  HANDLE openKmtHandle(HANDLE) {
+    return INVALID_HANDLE_VALUE;
