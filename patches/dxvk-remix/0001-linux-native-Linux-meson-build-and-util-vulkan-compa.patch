diff --git a/scripts-common/embed_file.py b/scripts-common/embed_file.py
new file mode 100644
index 0000000..b439a87
--- /dev/null
+++ b/scripts-common/embed_file.py
@@ -0,0 +1,18 @@
+# Generates a C header that embeds a binary file, matching the nv_xxd output used on Windows.
+# Usage: embed_file.py <input> <output> <basename>
+import sys
+
+def main():
+    inputPath, outputPath, baseName = sys.argv[1], sys.argv[2], sys.argv[3]
+    with open(inputPath, 'rb') as f:
+        data = f.read()
+    with open(outputPath, 'w', encoding='utf-8') as f:
+        f.write(f'static unsigned char ___{baseName}[] = {{')
+        for i, b in enumerate(data):
+            if i % 16 == 0:
+                f.write('\n  ')
+            f.write(f'0x{b:02x},')
+        f.write('\n};\n')
+
+if __name__ == '__main__':
+    main()
