+// sprintf_s with an array destination, as used by the runtime.
+template<size_t N, typename... Args>
+inline int sprintf_s(char (&buffer)[N], const char* format, Args... args) {
+  return std::snprintf(buffer, N, format, args...);
+}
+
+template<typename... Args>
+inline int sprintf_s(char* buffer, size_t size, const char* format, Args... args) {
+  return std::snprintf(buffer, size, format, args...);
+}
+
+inline DWORD GetEnvironmentVariableA(const char* name, char* buffer, DWORD size) {
+  const char* value = std::getenv(name);
+  if (value == nullptr) {
+    return 0;
+  }
+  const size_t len = std::strlen(value);
+  if (buffer == nullptr || len + 1 > size) {
+    return static_cast<DWORD>(len + 1);
+  }
+  std::memcpy(buffer, value, len + 1);
+  return static_cast<DWORD>(len);
+}
