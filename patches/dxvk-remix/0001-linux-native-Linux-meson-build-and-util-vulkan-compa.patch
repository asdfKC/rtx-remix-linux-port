+// Dynamic loading maps to dlopen and dlsym. A ".dll" suffix is replaced by ".so".
+namespace remix_linux {
+  inline std::string toSharedObjectName(const std::string& name) {
+    std::string result = name;
+    if (result.size() > 4 && (result.compare(result.size() - 4, 4, ".dll") == 0 || result.compare(result.size() - 4, 4, ".DLL") == 0)) {
+      result.replace(result.size() - 4, 4, ".so");
+    }
+    return result;
+  }
+}
+
+inline HMODULE LoadLibraryA(const char* name) {
+  return ::dlopen(remix_linux::toSharedObjectName(name).c_str(), RTLD_NOW | RTLD_LOCAL);
+}
+
+inline HMODULE LoadLibraryW(const wchar_t* name) {
+  char buffer[4096];
+  remix_linux::wideToUtf8(name, -1, buffer, sizeof(buffer));
+  return LoadLibraryA(buffer);
+}
+
+inline BOOL FreeLibrary(HMODULE module) {
+  return module != nullptr && ::dlclose(module) == 0;
+}
+
+inline void* GetProcAddress(HMODULE module, const char* name) {
+  return module ? ::dlsym(module, name) : nullptr;
+}
+
+// GetModuleHandle only reports objects that are already loaded.
+inline HMODULE GetModuleHandleA(const char* name) {
+  if (name == nullptr) {
+    return ::dlopen(nullptr, RTLD_NOW);
+  }
+  return ::dlopen(remix_linux::toSharedObjectName(name).c_str(), RTLD_NOW | RTLD_NOLOAD);
+}
+
+inline HMODULE GetModuleHandleW(const wchar_t* name) {
+  if (name == nullptr) {
+    return GetModuleHandleA(nullptr);
+  }
+  char buffer[4096];
+  remix_linux::wideToUtf8(name, -1, buffer, sizeof(buffer));
+  return GetModuleHandleA(buffer);
+}
+
+#define GetModuleHandle GetModuleHandleA
+#define LoadLibrary LoadLibraryA
+
+#define GetProcAddressA GetProcAddress
+
+inline void OutputDebugStringA(const char*) {
+}
+
+inline void OutputDebugStringW(const wchar_t*) {
+}
