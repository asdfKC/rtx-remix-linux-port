 #include <atomic>
 
 namespace remix_linux {
-  static std::atomic<uint32_t> g_clientWidth { 1920 };
-  static std::atomic<uint32_t> g_clientHeight { 1080 };
+  // Initial size from REMIX_LINUX_WINDOW_SIZE=<width>x<height>, else 1920x1080.
+  static uint32_t initialClientSize(bool height) {
+    unsigned w = 1920;
+    unsigned h = 1080;
+    if (const char* env = std::getenv("REMIX_LINUX_WINDOW_SIZE")) {
+      unsigned ew = 0;
+      unsigned eh = 0;
+      if (std::sscanf(env, "%ux%u", &ew, &eh) == 2 && ew > 0 && eh > 0) {
+        w = ew;
+        h = eh;
+      }
+    }
+    return height ? h : w;
+  }
+
+  static std::atomic<uint32_t> g_clientWidth { initialClientSize(false) };
+  static std::atomic<uint32_t> g_clientHeight { initialClientSize(true) };
 
   void getHeadlessClientSize(uint32_t* width, uint32_t* height) {
     *width = g_clientWidth;
