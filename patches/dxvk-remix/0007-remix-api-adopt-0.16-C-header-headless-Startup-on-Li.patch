+  remixapi_ErrorCode REMIXAPI_CALL remixapi_ReleaseConfigLayer(remixapi_ConfigLayerHandle handle) {
+    if (!handle) {
+      return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+    }
+    auto& layers = apiConfigLayers();
+    std::lock_guard lock { layers.mutex };
+    for (auto it = layers.byKey.begin(); it != layers.byKey.end(); ++it) {
+      if (reinterpret_cast<remixapi_ConfigLayerHandle>(it->second.first) == handle) {
+        if (--it->second.second == 0) {
+          layers.byKey.erase(it);
+        }
+        return REMIXAPI_ERROR_CODE_SUCCESS;
+      }
+    }
+    return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+  }
