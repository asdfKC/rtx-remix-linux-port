+    remixapi_ConfigLayerHandle* out_handle) {
+    if (!path || !out_handle || !std::isfinite(priority) || !std::isfinite(blendThreshold)) {
+      return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+    }
+    if (!tryAsDxvk()) {
+      return REMIXAPI_ERROR_CODE_REMIX_DEVICE_WAS_NOT_REGISTERED;
+    }
+    auto& layers = apiConfigLayers();
+    std::lock_guard lock { layers.mutex };
+    const std::string key = dxvk::str::format(priority, "|", path);
+    auto it = layers.byKey.find(key);
+    if (it == layers.byKey.end()) {
+      it = layers.byKey.emplace(key, std::make_pair(layers.nextId++, 0u)).first;
+      dxvk::Logger::warn(dxvk::str::format("[RemixAPI] Config layers are not implemented by this runtime. Ignoring: ", path));
+    }
+    it->second.second++;
