   // API 0.16 entry points. Parts that are not implemented yet fail through notImplemented() so the caller
   // sees an error instead of a null function pointer.
 
+  // ---- API textures (0.16) ----------------------------------------------------------------------------------
+  // See PORTING_NOTES.md, Phase C step 3. Pixel data is converted to the image layout on the caller thread, so the
+  // caller's buffers are free once a call returns. Upload and mip generation run on the CS thread.
+
+  struct ApiTexelLayout {
+    uint32_t srcBytes = 0;       // bytes per texel in the API format
+    uint32_t dstBytes = 0;       // bytes per texel in the image
+    VkFormat imageFormat = VK_FORMAT_UNDEFINED;   // upload and mip-generation format
+    VkFormat sampledFormat = VK_FORMAT_UNDEFINED; // format materials sample through (sRGB view of an 8-bit image)
+    bool swizzleBgra = false;
+    bool normalToOctahedral = false;
+    bool flipNormalY = false;
+  };
+
+  bool colorUnormAsSrgb() {
+    // Diagnostic switch for the GPU bring-up: sample RGBA8/BGRA8_UNORM color textures as sRGB.
+    static const bool s_enabled = dxvk::env::getEnvVar("REMIX_LINUX_COLOR_UNORM_AS_SRGB") == "1";
+    return s_enabled;
+  }
+
+  std::optional<ApiTexelLayout> toTexelLayout(remixapi_TextureFormat format, remixapi_TexturePurpose purpose) {
+    ApiTexelLayout l;
+    switch (format) {
+    case REMIXAPI_TEXTURE_FORMAT_RGBA8_UNORM:   l = { 4, 4, VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_UNORM }; break;
+    case REMIXAPI_TEXTURE_FORMAT_RGBA8_SRGB:    l = { 4, 4, VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_SRGB }; break;
+    case REMIXAPI_TEXTURE_FORMAT_BGRA8_UNORM:   l = { 4, 4, VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_UNORM, true }; break;
+    case REMIXAPI_TEXTURE_FORMAT_BGRA8_SRGB:    l = { 4, 4, VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_SRGB, true }; break;
+    case REMIXAPI_TEXTURE_FORMAT_R8_UNORM:      l = { 1, 1, VK_FORMAT_R8_UNORM, VK_FORMAT_R8_UNORM }; break;
+    case REMIXAPI_TEXTURE_FORMAT_RG8_UNORM:     l = { 2, 2, VK_FORMAT_R8G8_UNORM, VK_FORMAT_R8G8_UNORM }; break;
+    case REMIXAPI_TEXTURE_FORMAT_RGBA16_SFLOAT: l = { 8, 8, VK_FORMAT_R16G16B16A16_SFLOAT, VK_FORMAT_R16G16B16A16_SFLOAT }; break;
+    case REMIXAPI_TEXTURE_FORMAT_RGBA32_SFLOAT: l = { 16, 16, VK_FORMAT_R32G32B32A32_SFLOAT, VK_FORMAT_R32G32B32A32_SFLOAT }; break;
+    case REMIXAPI_TEXTURE_FORMAT_R32_SFLOAT:    l = { 4, 4, VK_FORMAT_R32_SFLOAT, VK_FORMAT_R32_SFLOAT }; break;
+    default:
+      return std::nullopt;
+    }
+
+    switch (purpose) {
+    case REMIXAPI_TEXTURE_PURPOSE_COLOR:
+      if (colorUnormAsSrgb() && l.imageFormat == VK_FORMAT_R8G8B8A8_UNORM) {
+        l.sampledFormat = VK_FORMAT_R8G8B8A8_SRGB;
+      }
+      break;
+    case REMIXAPI_TEXTURE_PURPOSE_DATA:
+    case REMIXAPI_TEXTURE_PURPOSE_NORMAL_OTH:
+    case REMIXAPI_TEXTURE_PURPOSE_HEIGHTMAP:
+      break;
+    case REMIXAPI_TEXTURE_PURPOSE_NORMAL_DX:
+    case REMIXAPI_TEXTURE_PURPOSE_NORMAL_OGL:
+      // Tangent-space normals become 2-channel unsigned octahedral, which is what the material shaders decode.
+      if (format != REMIXAPI_TEXTURE_FORMAT_RGBA8_UNORM && format != REMIXAPI_TEXTURE_FORMAT_BGRA8_UNORM &&
+          format != REMIXAPI_TEXTURE_FORMAT_RG8_UNORM) {
+        return std::nullopt;
+      }
+      l.dstBytes = 2;
+      l.imageFormat = VK_FORMAT_R8G8_UNORM;
+      l.sampledFormat = VK_FORMAT_R8G8_UNORM;
+      l.normalToOctahedral = true;
+      // The shaders build the bitangent along +V, which points down the image: the DirectX convention.
+      l.flipNormalY = purpose == REMIXAPI_TEXTURE_PURPOSE_NORMAL_OGL;
+      break;
+    default:
+      return std::nullopt;
+    }
+    return l;
+  }
+
+  MipmapMethod toMipmapMethod(remixapi_TexturePurpose purpose) {
+    // Height maps keep the maximum in each mip for hierarchical POM raymarching.
+    return purpose == REMIXAPI_TEXTURE_PURPOSE_HEIGHTMAP ? MipmapMethod::Maximum : MipmapMethod::Simple;
+  }
+
+  uint8_t unormToByte(float v) {
+    return static_cast<uint8_t>(std::lround(std::clamp(v, 0.0f, 1.0f) * 255.0f));
+  }
+
+  // Converts w x h texels from the API layout (rows srcPitch bytes apart) into tightly packed image texels.
+  void convertTexels(const ApiTexelLayout& l, const uint8_t* src, uint32_t w, uint32_t h, size_t srcPitch, uint8_t* dst) {
+    for (uint32_t y = 0; y < h; ++y) {
+      const uint8_t* s = src + y * srcPitch;
+      uint8_t* d = dst + size_t(y) * w * l.dstBytes;
+      if (!l.swizzleBgra && !l.normalToOctahedral) {
+        memcpy(d, s, size_t(w) * l.srcBytes);
+        continue;
+      }
+      for (uint32_t x = 0; x < w; ++x, s += l.srcBytes, d += l.dstBytes) {
+        if (!l.normalToOctahedral) {
+          d[0] = s[2]; d[1] = s[1]; d[2] = s[0]; d[3] = s[3];
+          continue;
+        }
+        float nx, ny, nz;
+        if (l.srcBytes == 2) {
+          nx = s[0] / 127.5f - 1.0f;
+          ny = s[1] / 127.5f - 1.0f;
+          nz = std::sqrt(std::max(0.0f, 1.0f - nx * nx - ny * ny));
+        } else {
+          const uint8_t r = l.swizzleBgra ? s[2] : s[0];
+          const uint8_t b = l.swizzleBgra ? s[0] : s[2];
+          nx = r / 127.5f - 1.0f;
+          ny = s[1] / 127.5f - 1.0f;
+          nz = b / 127.5f - 1.0f;
+        }
+        if (l.flipNormalY) {
+          ny = -ny;
+        }
+        nz = std::max(nz, 0.0f);
+        // Same encoding as hemisphereDirectionToUnsignedOctahedral() in the shaders.
+        const float sum = std::abs(nx) + std::abs(ny) + nz;
+        float px = 0.0f, py = 0.0f;
+        if (sum > 1e-6f) {
+          px = nx / sum;
+          py = ny / sum;
+        }
+        d[0] = unormToByte((px + py) * 0.5f + 0.5f);
+        d[1] = unormToByte((px - py) * 0.5f + 0.5f);
+      }
+    }
+  }
+
+  uint32_t fullMipCount(uint32_t w, uint32_t h) {
+    uint32_t levels = 1;
+    for (uint32_t size = std::max(w, h); size > 1; size >>= 1) {
+      ++levels;
+    }
+    return levels;
+  }
+
+  // CS thread. Regenerates mips 1..n from mip 0 and makes the image visible to the shaders that sample it.
+  void finishApiTextureUploadCs(dxvk::RtxContext* ctx, ApiTextureRegistry::Entry& entry) {
+    using namespace dxvk;
+    ctx->emitMemoryBarrier(0,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+    if (entry.mipViews.size() > 1) {
+      RtxMipmap::Resource mipmap;
+      mipmap.image = entry.image;
+      mipmap.view = entry.mipViews[0];
+      mipmap.views = entry.mipViews;
+      RtxMipmap::updateMipmap(Rc<RtxContext>(ctx), mipmap, entry.mipMethod);
+      ctx->setPushConstantBank(DxvkPushConstantBank::D3D9);
+    }
+    ctx->emitMemoryBarrier(0,
+      VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+      VK_ACCESS_SHADER_READ_BIT);
+    apiTextures().uploads++;
+  }
+
+  // CS thread.
+  void createApiTextureCs(dxvk::RtxContext* ctx, remixapi_TextureHandle handle, uint64_t hash, const ApiTexelLayout& l,
+                          MipmapMethod mipMethod, uint32_t w, uint32_t h, const std::vector<uint8_t>& texels) {
+    using namespace dxvk;
+    Rc<DxvkDevice> device = ctx->getDevice();
+
+    // Mips are generated by a compute pass that writes storage views. Without storage support for the format the
+    // texture keeps mip 0 only.
+    const VkFormatProperties props = device->adapter()->formatProperties(l.imageFormat);
+    const bool canStore = (props.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT) != 0;
+    const uint32_t mipLevels = canStore ? fullMipCount(w, h) : 1;
+    if (!canStore) {
+      ONCE(Logger::warn(str::format("[RemixAPI] Texture format ", l.imageFormat, " has no storage support; API textures of this format get no mips.")));
+    }
+
+    const VkFormat viewFormats[2] = { l.imageFormat, l.sampledFormat };
+    const bool mutableFormat = l.sampledFormat != l.imageFormat;
+
+    DxvkImageCreateInfo desc;
+    desc.type = VK_IMAGE_TYPE_2D;
+    desc.format = l.imageFormat;
+    desc.flags = mutableFormat ? VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT : 0;
+    desc.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    desc.extent = VkExtent3D { w, h, 1 };
+    desc.numLayers = 1;
+    desc.mipLevels = mipLevels;
+    desc.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                 (canStore ? VK_IMAGE_USAGE_STORAGE_BIT : 0);
+    desc.stages = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+                  VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+    desc.access = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT |
+                  VK_ACCESS_SHADER_WRITE_BIT;
+    desc.tiling = VK_IMAGE_TILING_OPTIMAL;
+    desc.layout = VK_IMAGE_LAYOUT_GENERAL;
+    if (mutableFormat) {
+      desc.viewFormatCount = 2;
+      desc.viewFormats = viewFormats;
+    }
+
+    ApiTextureRegistry::Entry entry;
+    entry.image = device->createImage(desc, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, DxvkMemoryStats::Category::RTXMaterialTexture,
+                                      "remix api texture");
+    entry.image->setHash(hash != 0 ? hash : XXH64(&handle, sizeof(handle), 0));
+    entry.mipMethod = mipMethod;
+
+    DxvkImageViewCreateInfo viewInfo;
+    viewInfo.type = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    viewInfo.minLayer = 0;
+    viewInfo.numLayers = 1;
+    if (mipLevels > 1) {
+      viewInfo.format = l.imageFormat;
+      viewInfo.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+      viewInfo.numLevels = 1;
+      for (uint32_t i = 0; i < mipLevels; ++i) {
+        viewInfo.minLevel = i;
+        entry.mipViews.push_back(device->createImageView(entry.image, viewInfo));
+      }
+    }
+    viewInfo.format = l.sampledFormat;
+    viewInfo.usage = VK_IMAGE_USAGE_SAMPLED_BIT;
+    viewInfo.minLevel = 0;
+    viewInfo.numLevels = mipLevels;
+    entry.ref = TextureRef { device->createImageView(entry.image, viewInfo) };
+
+    ctx->updateImage(entry.image, VkImageSubresourceLayers { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                     VkOffset3D { 0, 0, 0 }, desc.extent, texels.data(), size_t(w) * l.dstBytes, texels.size());
+    finishApiTextureUploadCs(ctx, entry);
+
+    apiTextures().textures.insert_or_assign(handle, std::move(entry));
+  }
+
+  struct ApiTexturePatchCs {
+    uint32_t x, y, w, h;
+    std::vector<uint8_t> texels; // tightly packed, image layout
+  };
+
   remixapi_ErrorCode REMIXAPI_CALL remixapi_CreateTextureFromMemory(
     const remixapi_TextureFromMemoryInfo* info,
     remixapi_TextureHandle* out_handle) {
-    return notImplemented("CreateTextureFromMemory");
+    if (!info || !out_handle || info->sType != REMIXAPI_STRUCT_TYPE_TEXTURE_FROM_MEMORY_INFO || !info->pixelData ||
+        info->width == 0 || info->height == 0) {
+      return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+    }
+    dxvk::D3D9DeviceEx* remixDevice = tryAsDxvk();
+    if (!remixDevice) {
+      return REMIXAPI_ERROR_CODE_REMIX_DEVICE_WAS_NOT_REGISTERED;
+    }
+    const auto layout = toTexelLayout(info->format, info->purpose);
+    const uint32_t maxDim = remixDevice->GetDXVKDevice()->properties().core.properties.limits.maxImageDimension2D;
+    if (!layout || info->width > maxDim || info->height > maxDim) {
+      return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+    }
+
+    std::vector<uint8_t> texels(size_t(info->width) * info->height * layout->dstBytes);
+    convertTexels(*layout, info->pixelData, info->width, info->height, size_t(info->width) * layout->srcBytes, texels.data());
+
+    std::lock_guard lock { s_mutex };
+    auto& caller = apiTexturesCaller();
+    const auto handle = reinterpret_cast<remixapi_TextureHandle>(caller.nextHandle++);
+    caller.live.emplace(handle, ApiTextureDesc { info->width, info->height, info->format, info->purpose, false });
+
+    remixDevice->EmitCs([cHandle = handle, cHash = info->hash, cLayout = *layout, cMipMethod = toMipmapMethod(info->purpose),
+                         cWidth = info->width, cHeight = info->height, cTexels = std::move(texels)](dxvk::DxvkContext* ctx) {
+      createApiTextureCs(static_cast<dxvk::RtxContext*>(ctx), cHandle, cHash, cLayout, cMipMethod, cWidth, cHeight, cTexels);
+    });
+    *out_handle = handle;
+    return REMIXAPI_ERROR_CODE_SUCCESS;
   }
 
   remixapi_ErrorCode REMIXAPI_CALL remixapi_CreateTextureFromFile(
     remixapi_Path filePath,
     remixapi_TextureHandle* out_handle) {
-    return notImplemented("CreateTextureFromFile");
+    if (!filePath || filePath[0] == L'\0' || !out_handle) {
+      return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
