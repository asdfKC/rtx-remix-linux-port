+    if (!std::filesystem::is_regular_file(path, ec)) {
+      dxvk::Logger::err(dxvk::str::format("[RemixAPI] CreateTextureFromFile: not a readable file: ", path.string()));
+      return REMIXAPI_ERROR_CODE_GENERAL_FAILURE;
+    }
+
+    std::lock_guard lock { s_mutex };
+    auto& caller = apiTexturesCaller();
+    const auto handle = reinterpret_cast<remixapi_TextureHandle>(caller.nextHandle++);
+    caller.live.emplace(handle, ApiTextureDesc { 0, 0, REMIXAPI_TEXTURE_FORMAT_RGBA8_UNORM, REMIXAPI_TEXTURE_PURPOSE_COLOR, true });
+
+    // Same loading path the 0.6.6 runtime used for material texture paths. A file that fails to decode leaves the
+    // handle valid but empty (untextured), with an error in the log.
+    remixDevice->EmitCs([cHandle = handle, cPath = path.string()](dxvk::DxvkContext* ctx) {
+      auto assetData = dxvk::AssetDataManager::get().findAsset(cPath);
+      ApiTextureRegistry::Entry entry;
+      if (assetData != nullptr) {
+        entry.ref = dxvk::TextureRef { ctx->getCommonObjects()->getTextureManager()
+          .preloadTextureAsset(assetData, dxvk::ColorSpace::AUTO, false) };
+      } else {
+        dxvk::Logger::err(dxvk::str::format("[RemixAPI] CreateTextureFromFile: could not load ", cPath));
+      }
+      apiTextures().textures.insert_or_assign(cHandle, std::move(entry));
+    });
+    *out_handle = handle;
+    return REMIXAPI_ERROR_CODE_SUCCESS;
   }
 
