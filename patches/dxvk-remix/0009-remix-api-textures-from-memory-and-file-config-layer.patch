+// Diagnostics for tests: waits for the CS thread, then reports the API textures it holds, how many of them resolve to
+// a texture, the completed memory-texture uploads, and the live config layers. Not for use while other threads call
+// the API.
+extern "C" REMIXAPI void REMIXAPI_CALL remixlinux_GetApiResourceStats(uint64_t* outTextures, uint64_t* outResolvedTextures,
+                                                                      uint64_t* outUploads, uint64_t* outConfigLayers) {
+  uint64_t textures = 0, resolved = 0, uploads = 0, layers = 0;
+  {
+    std::lock_guard lock { s_mutex };
+    if (s_dxvkDevice) {
+      s_dxvkDevice->SynchronizeCsThread();
+    }
+    textures = apiTextures().textures.size();
+    for (const auto& [handle, entry] : apiTextures().textures) {
+      resolved += entry.ref.isValid() ? 1 : 0;
+    }
+    uploads = apiTextures().uploads;
+    layers = csConfigLayers().size();
+  }
+  if (outTextures) *outTextures = textures;
+  if (outResolvedTextures) *outResolvedTextures = resolved;
+  if (outUploads) *outUploads = uploads;
+  if (outConfigLayers) *outConfigLayers = layers;
