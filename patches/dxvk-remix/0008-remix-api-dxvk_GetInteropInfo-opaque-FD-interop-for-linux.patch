 src/d3d9/d3d9_swapchain_external.cpp  |  88 +++++++++++++++++
 src/dxvk/dxvk_image.h                 |  11 ++-
 src/dxvk/rtx_render/rtx_remix_api.cpp | 132 ++++++++++++++++++++++++++
 src/dxvk/rtx_render/rtx_semaphore.cpp |  33 ++++++-
 5 files changed, 289 insertions(+), 2 deletions(-)

