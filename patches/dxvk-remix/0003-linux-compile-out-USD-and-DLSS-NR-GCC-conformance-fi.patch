diff --git a/linux/include/nvapi.h b/linux/include/nvapi.h
new file mode 100644
index 0000000..3ce268f
--- /dev/null
+++ b/linux/include/nvapi.h
@@ -0,0 +1,7 @@
+#pragma once
+// Wraps the NVAPI header for the native Linux build. NVAPI uses Microsoft SAL annotations,
+// which would clash with libstdc++ internals if they stayed defined, so they only exist around the include.
+// NVAPI itself is unavailable on Linux. linux/stubs implements the entry points the runtime calls as failing.
+#include "remix_sal.h"
+#include_next <nvapi.h>
+#include "remix_sal_undef.h"
diff --git a/linux/include/remix_linux_compat.h b/linux/include/remix_linux_compat.h
index 22a1dba..eec2579 100644
--- a/linux/include/remix_linux_compat.h
+++ b/linux/include/remix_linux_compat.h
@@ -63,6 +63,11 @@
 #define MAX_PATH 260
 #endif
 
+// MSVC calling conventions and SAL annotations used by vendor headers.
+#ifndef __cdecl
+#define __cdecl
+#endif
+
 #ifndef __forceinline
 #define __forceinline inline __attribute__((always_inline))
 #endif
