+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.nvidia.rtxremix.minecraft.gl;
+
+import com.nvidia.rtxremix.RemixBridge;
+import org.lwjgl.opengl.GL11;
+import org.lwjgl.opengl.GLCapabilities;
+import org.lwjgl.system.Platform;
+
+import static org.lwjgl.opengl.EXTMemoryObjectFD.GL_HANDLE_TYPE_OPAQUE_FD_EXT;
+import static org.lwjgl.opengl.EXTMemoryObjectFD.glImportMemoryFdEXT;
+import static org.lwjgl.opengl.EXTMemoryObjectWin32.GL_HANDLE_TYPE_OPAQUE_WIN32_EXT;
+import static org.lwjgl.opengl.EXTMemoryObjectWin32.glImportMemoryWin32HandleEXT;
+import static org.lwjgl.opengl.EXTSemaphoreFD.glImportSemaphoreFdEXT;
+import static org.lwjgl.opengl.EXTSemaphoreWin32.glImportSemaphoreWin32HandleEXT;
+
+/**
+ * How Remix interop handles reach OpenGL on each platform. Everything else in
+ * {@link GlInterop} is platform-neutral.
+ *
+ * <p>Windows: the {@code InteropInfo} handle fields carry Win32 handles,
+ * imported with {@code EXT_memory_object_win32} and {@code EXT_semaphore_win32}.
+ * This is unchanged.
+ *
+ * <p>Linux: the handle fields are assumed to carry opaque POSIX file descriptors
+ * ({@code VK_EXTERNAL_*_HANDLE_TYPE_OPAQUE_FD_BIT}), imported with
+ * {@code EXT_memory_object_fd} and {@code EXT_semaphore_fd}. A successful GL
+ * import takes ownership of the descriptor it is given. The runtime is assumed
+ * to keep owning the descriptors it reports, and to report the same descriptor
+ * while an allocation is unchanged. GlInterop's change detection compares handle
+ * values, so this class imports a {@code dup()} and the runtime's descriptor
+ * stays valid. If the interop work settles on the runtime handing the client a
+ * fresh descriptor on every call instead, import the descriptor itself in
+ * {@link #importFd} and stop comparing handle values in GlInterop.
+ */
+public final class InteropHandles {
+    static final boolean POSIX_FD = Platform.get() != Platform.WINDOWS;
+
+    private InteropHandles() {}
+
+    /** Returns the first missing handle-import extension, or null when all are present. */
+    public static String missingExtension(GLCapabilities caps) {
+        if (POSIX_FD) {
+            if (!caps.GL_EXT_memory_object_fd) return "GL_EXT_memory_object_fd";
+            if (!caps.GL_EXT_semaphore_fd) return "GL_EXT_semaphore_fd";
+        } else {
+            if (!caps.GL_EXT_memory_object_win32) return "GL_EXT_memory_object_win32";
+            if (!caps.GL_EXT_semaphore_win32) return "GL_EXT_semaphore_win32";
+        }
+        return null;
+    }
+
+    /**
+     * True when a handle field carries a handle. 0 and -1 mean none on both
+     * platforms: descriptor 0 is the process's stdin, never an exported object.
+     */
+    static boolean present(long handle) {
+        return handle != 0 && handle != -1L;
+    }
+
+    static void importSemaphore(int semaphore, long handle) {
+        if (POSIX_FD) {
+            importFd(handle, fd -> glImportSemaphoreFdEXT(semaphore, GL_HANDLE_TYPE_OPAQUE_FD_EXT, fd));
+        } else {
+            glImportSemaphoreWin32HandleEXT(semaphore, GL_HANDLE_TYPE_OPAQUE_WIN32_EXT, handle);
+        }
+    }
+
+    static void importMemory(int memoryObject, long allocationSize, long handle) {
+        if (POSIX_FD) {
+            importFd(handle, fd -> glImportMemoryFdEXT(memoryObject, allocationSize, GL_HANDLE_TYPE_OPAQUE_FD_EXT, fd));
+        } else {
+            glImportMemoryWin32HandleEXT(memoryObject, allocationSize, GL_HANDLE_TYPE_OPAQUE_WIN32_EXT, handle);
+        }
+    }
+
+    /**
+     * Imports a duplicate of {@code handle}. GL owns the duplicate after a
+     * successful import; after a failed one ownership stays here, so it is closed.
+     * The caller has drained stale GL errors, as GlInterop does before every import.
+     */
+    private static void importFd(long handle, java.util.function.IntConsumer glImport) {
+        if (handle < 0 || handle > Integer.MAX_VALUE) {
+            throw new IllegalArgumentException("Interop handle is not a file descriptor: " + handle);
+        }
+        int fd = RemixBridge.posixDupFd((int) handle);
+        if (fd < 0) {
+            throw new IllegalStateException("dup() of interop descriptor " + handle + " failed");
+        }
+        glImport.accept(fd);
+        int error = GL11.glGetError();
+        if (error != GL11.GL_NO_ERROR) {
+            RemixBridge.posixCloseFd(fd);
+            throw new IllegalStateException(
+                    "OpenGL error importing interop descriptor: 0x" + Integer.toHexString(error));
+        }
+    }
+}
