 }
 
+// ─── Linux ───────────────────────────────────────────────────────────────
+
+JNIEXPORT jint JNICALL
+Java_com_nvidia_rtxremix_RemixBridge_linuxSetOutputSize(JNIEnv*, jclass, jint width, jint height)
+{
+#ifdef _WIN32
+    return REMIXAPI_ERROR_CODE_GET_PROC_ADDRESS_FAILURE;
+#else
+    if (!g_inited || !g_remixDll) return REMIXAPI_ERROR_CODE_NOT_INITIALIZED;
+    if (width <= 0 || height <= 0) return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+    typedef void (*PFN_remixlinux_SetWindowSize)(uint32_t, uint32_t);
+    static PFN_remixlinux_SetWindowSize setWindowSize = nullptr;
+    static void* resolvedFrom = nullptr;
+    if (resolvedFrom != g_remixDll) {
+        setWindowSize = (PFN_remixlinux_SetWindowSize)dlsym(g_remixDll, "remixlinux_SetWindowSize");
+        resolvedFrom = g_remixDll;
+    }
+    if (!setWindowSize) return REMIXAPI_ERROR_CODE_GET_PROC_ADDRESS_FAILURE;
+    setWindowSize((uint32_t)width, (uint32_t)height);
+    return REMIXAPI_ERROR_CODE_SUCCESS;
+#endif
+}
+
+JNIEXPORT jint JNICALL
+Java_com_nvidia_rtxremix_RemixBridge_posixDupFd(JNIEnv*, jclass, jint fd)
+{
+#ifdef _WIN32
+    return -1;
+#else
+    return (jint)fcntl((int)fd, F_DUPFD_CLOEXEC, 0);
+#endif
+}
+
+JNIEXPORT void JNICALL
+Java_com_nvidia_rtxremix_RemixBridge_posixCloseFd(JNIEnv*, jclass, jint fd)
+{
+#ifndef _WIN32
+    if (fd >= 0) close((int)fd);
+#endif
+}
+
 } // extern "C"
