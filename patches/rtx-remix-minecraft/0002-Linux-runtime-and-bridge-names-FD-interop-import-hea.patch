@@ -0,0 +1,56 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.nvidia.rtxremix.minecraft;
+
+import com.nvidia.rtxremix.ErrorCode;
+import com.nvidia.rtxremix.RemixBridge;
+import net.minecraft.client.util.Window;
+import org.lwjgl.glfw.GLFW;
+import org.lwjgl.system.Platform;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Present path for the native Linux runtime, which is headless: it has no
+ * window and no Vulkan swapchain. Remix still renders into the interop image
+ * and GL composites over it as on Windows. Present runs with
+ * {@code skipVulkanSwapchain} and the GL back buffer is then swapped by GLFW,
+ * instead of Remix presenting through its own swapchain.
+ *
+ * <p>The runtime cannot query a window size, so the framebuffer size is passed
+ * to it before Startup and after every present.
+ */
+final class LinuxPresent {
+    private static final Logger LOGGER = LoggerFactory.getLogger(LinuxPresent.class);
+
+    static final boolean ACTIVE = Platform.get() == Platform.LINUX;
+
+    private static int lastWidth = -1;
+    private static int lastHeight = -1;
+
+    private LinuxPresent() {}
+
+    static void syncOutputSize(Window window) {
+        int width = window.getFramebufferWidth();
+        int height = window.getFramebufferHeight();
+        if (width <= 0 || height <= 0 || (width == lastWidth && height == lastHeight)) {
+            return;
+        }
+        int result = RemixBridge.linuxSetOutputSize(width, height);
+        if (result != ErrorCode.SUCCESS) {
+            LOGGER.warn("Remix output size {}x{} not applied (error {})", width, height, result);
+            return;
+        }
+        lastWidth = width;
+        lastHeight = height;
+        LOGGER.info("Remix output size {}x{}", width, height);
+    }
+
+    /** Swaps the GL back buffer, which holds this frame, and tracks resizes for the next one. */
+    static void afterRemixPresent(Window window) {
+        GLFW.glfwSwapBuffers(window.getHandle());
+        syncOutputSize(window);
+    }
+}
