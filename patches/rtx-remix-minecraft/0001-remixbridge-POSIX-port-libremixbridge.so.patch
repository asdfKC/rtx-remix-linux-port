+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+#
+# Builds the JNI bridge: libremixbridge.so on Linux. Windows keeps build_native.bat.
+#
+#   cmake -S rtxremix-java/native -B build/native-cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo
+#   cmake --build build/native-cmake
+#
+# Output: build/native/linux64/libremixbridge.so under the repository root, matching
+# build_native.bat's build/native/<arch>/ layout.
+cmake_minimum_required(VERSION 3.16)
+project(remixbridge LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+# JNI headers: JAVA_HOME first (the JDK Gradle runs with), else CMake's search.
+if(DEFINED ENV{JAVA_HOME} AND EXISTS "$ENV{JAVA_HOME}/include/jni.h")
+  set(JNI_HEADERS "$ENV{JAVA_HOME}/include" "$ENV{JAVA_HOME}/include/linux")
+else()
+  find_package(JNI REQUIRED)
+  set(JNI_HEADERS ${JNI_INCLUDE_DIRS})
+endif()
+
+# Remix C header (override with -DREMIX_INCLUDE=...)
+set(REMIX_INCLUDE "${CMAKE_CURRENT_SOURCE_DIR}/include" CACHE PATH "Directory containing remix_c.h")
+if(NOT EXISTS "${REMIX_INCLUDE}/remix_c.h")
+  message(FATAL_ERROR "remix_c.h not found in ${REMIX_INCLUDE}")
+endif()
+
+if(NOT DEFINED REMIXBRIDGE_OUTPUT_DIR)
+  set(REMIXBRIDGE_OUTPUT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../build/native/linux64")
+endif()
+
+add_library(remixbridge SHARED remixbridge.cpp)
+target_include_directories(remixbridge PRIVATE ${JNI_HEADERS} "${REMIX_INCLUDE}")
+target_compile_options(remixbridge PRIVATE -Wall -Wno-unused-parameter)
+set_target_properties(remixbridge PROPERTIES
+  CXX_VISIBILITY_PRESET hidden
+  VISIBILITY_INLINES_HIDDEN ON
+  LIBRARY_OUTPUT_DIRECTORY "${REMIXBRIDGE_OUTPUT_DIR}")
+# Every symbol must resolve at link time: the bridge only needs libc and libdl.
+target_link_libraries(remixbridge PRIVATE ${CMAKE_DL_LIBS})
+target_link_options(remixbridge PRIVATE -Wl,--no-undefined -Wl,--as-needed)
