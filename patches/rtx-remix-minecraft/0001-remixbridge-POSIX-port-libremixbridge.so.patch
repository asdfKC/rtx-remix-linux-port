-// Tracy profiling: resolve ___tracy_* symbols from d3d9.dll at runtime so
+#else // POSIX
+
+// ════════════════════════════════════════════════════════════════════════════
+// Crash report (POSIX): fatal-signal handler that writes a human-readable
+// report and then hands the signal to the handler installed before it.
+//
+// The report holds the signal, fault address, faulting module, registers, a
+// backtrace of the faulting thread and the process memory map. It lands in
+// ./crash/ relative to the working directory, like the Windows report. There
+// is no minidump: enable core dumps (ulimit -c, coredumpctl) for deep
+// debugging. The JVM's own hs_err_pid*.log is written as well, because the
+// previous handler is normally the JVM's.
+//
+// The JVM takes SIGSEGV, SIGBUS, SIGFPE and SIGILL for implicit null checks,
+// safepoint polls and similar. Those fault in JIT code or in libjvm, so a
+// report is only written when the faulting instruction is in another loaded
+// library (the Remix runtime, this bridge, the driver), and for SIGABRT.
+// ════════════════════════════════════════════════════════════════════════════
+
+static const int kCrashSignals[] = { SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT };
+static struct sigaction g_prevActions[NSIG];
+static bool g_crashHandlerInstalled = false;
+static std::atomic<int> g_dumping{0};
+
+static void writeStr(int fd, const char* s) {
+    ssize_t unused = write(fd, s, strlen(s));
+    (void)unused;
+}
+
+static void writeHex(int fd, uint64_t v) {
+    char buf[19] = "0x";
+    for (int i = 0; i < 16; i++) {
+        unsigned n = (unsigned)((v >> (60 - 4 * i)) & 0xF);
+        buf[2 + i] = (char)(n < 10 ? '0' + n : 'A' + n - 10);
+    }
+    buf[18] = '\0';
+    writeStr(fd, buf);
+}
+
+static const char* signalName(int sig) {
+    switch (sig) {
+        case SIGSEGV: return "SIGSEGV";
+        case SIGBUS:  return "SIGBUS";
+        case SIGILL:  return "SIGILL";
+        case SIGFPE:  return "SIGFPE";
+        case SIGABRT: return "SIGABRT";
+        default:      return "UNKNOWN";
+    }
+}
+
+static uintptr_t faultPc(const ucontext_t* uc) {
+#if defined(__x86_64__)
+    return (uintptr_t)uc->uc_mcontext.gregs[REG_RIP];
+#elif defined(__aarch64__)
+    return (uintptr_t)uc->uc_mcontext.pc;
+#else
+    (void)uc;
+    return 0;
+#endif
+}
+
+// Resolve an address to "libname.so+0xOFFSET (symbol)" or "(JIT/heap)" if unmapped
+static void formatAddress(int fd, uintptr_t addr) {
+    Dl_info info;
+    if (dladdr((void*)addr, &info) && info.dli_fname) {
+        const char* base = strrchr(info.dli_fname, '/');
+        writeStr(fd, base ? base + 1 : info.dli_fname);
+        writeStr(fd, "+");
+        writeHex(fd, (uint64_t)(addr - (uintptr_t)info.dli_fbase));
+        if (info.dli_sname) {
+            writeStr(fd, " (");
+            writeStr(fd, info.dli_sname);
+            writeStr(fd, ")");
+        }
+        return;
+    }
+    writeHex(fd, (uint64_t)addr);
+    writeStr(fd, " (JIT/heap)");
+}
+
+// True for addresses the JVM owns: JIT code (not in any library) and libjvm.
+static bool isJvmAddress(uintptr_t pc) {
+    Dl_info info;
+    if (!dladdr((void*)pc, &info) || !info.dli_fname) return true;
+    const char* base = strrchr(info.dli_fname, '/');
+    base = base ? base + 1 : info.dli_fname;
+    return strcmp(base, "libjvm.so") == 0;
+}
+
+static void writeRegisters(int fd, const ucontext_t* uc) {
+    writeStr(fd, "\n=== Registers ===\n");
+#if defined(__x86_64__)
+    static const struct { const char* name; int reg; } regs[] = {
+        { "RAX", REG_RAX }, { "RBX", REG_RBX }, { "RCX", REG_RCX }, { "RDX", REG_RDX },
+        { "RSI", REG_RSI }, { "RDI", REG_RDI }, { "RSP", REG_RSP }, { "RBP", REG_RBP },
+        { "R8 ", REG_R8  }, { "R9 ", REG_R9  }, { "R10", REG_R10 }, { "R11", REG_R11 },
+        { "R12", REG_R12 }, { "R13", REG_R13 }, { "R14", REG_R14 }, { "R15", REG_R15 },
+        { "RIP", REG_RIP }, { "EFL", REG_EFL },
+    };
+    for (size_t i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+        writeStr(fd, (i % 4 == 0) ? "  " : "  ");
+        writeStr(fd, regs[i].name);
+        writeStr(fd, "=");
+        writeHex(fd, (uint64_t)uc->uc_mcontext.gregs[regs[i].reg]);
+        if (i % 4 == 3 || i + 1 == sizeof(regs) / sizeof(regs[0])) writeStr(fd, "\n");
+    }
+#elif defined(__aarch64__)
+    for (int i = 0; i < 31; i++) {
+        char name[8];
+        snprintf(name, sizeof(name), "  X%-2d=", i);
+        writeStr(fd, name);
+        writeHex(fd, (uint64_t)uc->uc_mcontext.regs[i]);
+        if (i % 4 == 3) writeStr(fd, "\n");
+    }
+    writeStr(fd, "\n  SP =");
+    writeHex(fd, (uint64_t)uc->uc_mcontext.sp);
+    writeStr(fd, "  PC =");
+    writeHex(fd, (uint64_t)uc->uc_mcontext.pc);
+    writeStr(fd, "\n");
+#else
+    (void)uc;
+#endif
+}
+
+static void copyFile(int fd, const char* path) {
+    int in = open(path, O_RDONLY | O_CLOEXEC);
+    if (in < 0) return;
+    char buf[4096];
+    ssize_t n;
+    while ((n = read(in, buf, sizeof(buf))) > 0) {
+        ssize_t unused = write(fd, buf, (size_t)n);
+        (void)unused;
+    }
+    close(in);
+}
+
+static void writeCrashReport(int sig, const siginfo_t* si, const ucontext_t* uc, uintptr_t pc) {
+    if (g_dumping.exchange(1) != 0)
+        return;
+
+    mkdir("crash", 0755);
+
+    char tag[32];
+    time_t now = time(nullptr);
+    struct tm tm;
+    localtime_r(&now, &tm);
+    snprintf(tag, sizeof(tag), "%04d%02d%02d_%02d%02d%02d",
+             tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday,
+             tm.tm_hour, tm.tm_min, tm.tm_sec);
+
+    char txtPath[96];
+    snprintf(txtPath, sizeof(txtPath), "crash/crash_report_%s.txt", tag);
+    int fd = open(txtPath, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) return;
+
+    writeStr(fd, "=== RTX Remix for Minecraft: Crash Report ===\n");
+    writeStr(fd, "No minidump on Linux: see the JVM's hs_err_pid*.log and the core dump, if enabled.\n\n");
+    writeStr(fd, "Signal:    ");
+    writeStr(fd, signalName(sig));
+    char num[64];
+    snprintf(num, sizeof(num), " (%d), code %d\n", sig, si ? si->si_code : 0);
+    writeStr(fd, num);
+    writeStr(fd, "Address:   ");
+    formatAddress(fd, pc);
+    writeStr(fd, "\n");
+    if (si && (sig == SIGSEGV || sig == SIGBUS)) {
+        writeStr(fd, "Fault:     ");
+        writeHex(fd, (uint64_t)(uintptr_t)si->si_addr);
+        writeStr(fd, "\n");
+    }
+    snprintf(num, sizeof(num), "Thread:    %ld\nProcess:   %ld\n", (long)syscall(SYS_gettid), (long)getpid());
+    writeStr(fd, num);
+
+    if (uc) writeRegisters(fd, uc);
+
+    // Only the faulting thread: there is no portable way to walk other threads
+    // from a signal handler. The JVM's hs_err log lists every thread.
+    writeStr(fd, "\n=== Faulting Thread Backtrace ===\n");
+    void* frames[64];
+    int count = backtrace(frames, 64);
+    backtrace_symbols_fd(frames, count, fd);
+
+    writeStr(fd, "\n=== Memory Map (/proc/self/maps) ===\n");
+    copyFile(fd, "/proc/self/maps");
+    close(fd);
+}
+
+// Hand the signal to the handler that was installed before ours.
+static void chainSignal(int sig, siginfo_t* si, void* ucv) {
+    const struct sigaction& prev = g_prevActions[sig];
+    if (prev.sa_flags & SA_SIGINFO) {
+        if (prev.sa_sigaction) {
+            prev.sa_sigaction(sig, si, ucv);
+            return;
+        }
+    } else if (prev.sa_handler == SIG_IGN) {
+        return;
+    } else if (prev.sa_handler != SIG_DFL && prev.sa_handler != nullptr) {
+        prev.sa_handler(sig);
+        return;
+    }
+    // Default action: reinstate it, then re-raise (a fault re-executes on return).
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+static void crashSignalHandler(int sig, siginfo_t* si, void* ucv) {
+    const ucontext_t* uc = (const ucontext_t*)ucv;
+    const uintptr_t pc = uc ? faultPc(uc) : 0;
+    if (sig == SIGABRT || !isJvmAddress(pc)) {
+        writeCrashReport(sig, si, uc, pc);
+    }
+    chainSignal(sig, si, ucv);
+}
+
+static void installCrashHandler() {
+    if (g_crashHandlerInstalled) return;
+    // backtrace() loads libgcc_s on first use, which must not happen inside a signal handler.
+    void* warmup[1];
+    backtrace(warmup, 1);
+
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = crashSignalHandler;
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+    sigemptyset(&sa.sa_mask);
+    for (int sig : kCrashSignals) {
+        sigaction(sig, &sa, &g_prevActions[sig]);
+    }
+    g_crashHandlerInstalled = true;
+}
+
+static void uninstallCrashHandler() {
+    if (!g_crashHandlerInstalled) return;
+    for (int sig : kCrashSignals) {
+        sigaction(sig, &g_prevActions[sig], nullptr);
+    }
+    g_crashHandlerInstalled = false;
+}
+
+#endif // _WIN32
+
+// Tracy profiling: resolve ___tracy_* symbols from d3d9.dll (libremix.so on Linux) at runtime so
 // Java zones appear on the same timeline as dxvk-remix zones. We can't use
 // TRACY_IMPORTS because we link against the Windows SDK d3d9.lib which
 // doesn't contain Tracy symbols.
@@ -314,6 +597,11 @@ static std::mutex           s_tracyMutex;
 static bool                 s_tracyResolved = false;
 static bool                 s_tracyAvailable = false;
 static bool                 s_tracyEnabled = false;
+#ifndef _WIN32
+// The loaded runtime library, set by initializeRuntime. A Linux runtime only
+// exposes Tracy when its export map includes the ___tracy_* symbols.
+static void*                s_tracyLibrary = nullptr;
+#endif
 
 static void resetTracyFunctionsLocked() {
     s_allocSrclocName = nullptr;
@@ -331,16 +619,24 @@ static bool initTracyFunctionsLocked() {
     if (!s_tracyEnabled) return false;
     if (s_tracyResolved) return s_tracyAvailable;
 
+#ifdef _WIN32
     HMODULE d3d9 = GetModuleHandleA("d3d9.dll");
     if (!d3d9) return false;
+#define TRACY_SYMBOL(name) GetProcAddress(d3d9, name)
+#else
+    void* d3d9 = s_tracyLibrary;
+    if (!d3d9) return false;
+#define TRACY_SYMBOL(name) dlsym(d3d9, name)
+#endif
 
-    s_allocSrclocName    = (FnAllocSrclocName)   GetProcAddress(d3d9, "___tracy_alloc_srcloc_name");
-    s_emitZoneBeginAlloc = (FnEmitZoneBeginAlloc)GetProcAddress(d3d9, "___tracy_emit_zone_begin_alloc");
-    s_emitZoneEnd        = (FnEmitZoneEnd)       GetProcAddress(d3d9, "___tracy_emit_zone_end");
-    s_setThreadName      = (FnSetThreadName)     GetProcAddress(d3d9, "___tracy_set_thread_name");
-    s_emitPlot           = (FnEmitPlot)          GetProcAddress(d3d9, "___tracy_emit_plot");
-    s_emitMessage        = (FnEmitMessage)       GetProcAddress(d3d9, "___tracy_emit_message");
-    s_emitFrameMark      = (FnEmitFrameMark)     GetProcAddress(d3d9, "___tracy_emit_frame_mark");
+    s_allocSrclocName    = (FnAllocSrclocName)   TRACY_SYMBOL("___tracy_alloc_srcloc_name");
+    s_emitZoneBeginAlloc = (FnEmitZoneBeginAlloc)TRACY_SYMBOL("___tracy_emit_zone_begin_alloc");
+    s_emitZoneEnd        = (FnEmitZoneEnd)       TRACY_SYMBOL("___tracy_emit_zone_end");
+    s_setThreadName      = (FnSetThreadName)     TRACY_SYMBOL("___tracy_set_thread_name");
+    s_emitPlot           = (FnEmitPlot)          TRACY_SYMBOL("___tracy_emit_plot");
+    s_emitMessage        = (FnEmitMessage)       TRACY_SYMBOL("___tracy_emit_message");
+    s_emitFrameMark      = (FnEmitFrameMark)     TRACY_SYMBOL("___tracy_emit_frame_mark");
+#undef TRACY_SYMBOL
 
     s_tracyAvailable = s_allocSrclocName && s_emitZoneBeginAlloc && s_emitZoneEnd;
     s_tracyResolved = true;
@@ -351,7 +647,11 @@ static bool initTracyFunctionsLocked() {
 // Global state: filled by initialize(), read by every other function.
 // ════════════════════════════════════════════════════════════════════════════
 
+#ifdef _WIN32
 static HMODULE          g_remixDll   = nullptr;
