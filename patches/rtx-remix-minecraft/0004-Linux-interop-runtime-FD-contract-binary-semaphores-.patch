+package com.nvidia.rtxremix.minecraft.gl;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class InteropHandlesTest {
+    private static final int RGBA8 = 0x8058;
+    private static final int SRGB8_ALPHA8 = 0x8C43;
+
+    @Test
+    void linuxKeepsAnImageWhoseDescriptorChangedButNotItsShape() {
+        // Every GetInteropInfo call hands out a new descriptor for the same image.
+        assertTrue(InteropHandles.sameImage(true, true, 41, 854, 480, RGBA8, 1_769_472,
+                57, 854, 480, RGBA8, 1_769_472));
+    }
+
+    @Test
+    void linuxReimportsWhenSizeFormatOrAllocationChanges() {
+        assertFalse(InteropHandles.sameImage(true, true, 41, 854, 480, RGBA8, 1_769_472,
+                57, 1920, 1080, RGBA8, 8_294_400));
+        assertFalse(InteropHandles.sameImage(true, true, 41, 854, 480, RGBA8, 1_769_472,
+                57, 854, 480, SRGB8_ALPHA8, 1_769_472));
+        assertFalse(InteropHandles.sameImage(true, true, 41, 854, 480, RGBA8, 1_769_472,
+                57, 854, 480, RGBA8, 2_000_000));
+    }
+
