     static final boolean POSIX_FD = Platform.get() != Platform.WINDOWS;
+    /** Windows drives NV timeline semaphores with values; Linux uses plain binary semaphores. */
+    static final boolean USES_TIMELINE_SEMAPHORES = !POSIX_FD;
 
     private InteropHandles() {}
 
