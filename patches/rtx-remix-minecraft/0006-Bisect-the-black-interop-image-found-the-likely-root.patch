From e5a188cda5fe6ff94da03a58c4c988a73799247d Mon Sep 17 00:00:00 2001
From: Kush J <kushisthecoolest@gmail.com>
Date: Mon, 26 Oct 2026 20:18:56 -0500
Subject: [PATCH] Bisect the black interop image: found the likely root cause

Verified (not fixed): the interop color image reads back as black
through the real GL path regardless of what Vulkan writes to it.
Temporarily re-added the Phase D step 5 debug-clear to the dxvk-remix
working tree (not committed, reverted with git checkout after use) and
ran it live on the RTX 5070: REMIX_INTEROP_DEBUG_CLEAR=1 (fill the
interop image directly) and =2 (clear the blit source just before the
real blit) both still dumped as pure black (avg=0 min=0 max=0),
confirmed by direct pixel inspection of the PPMs, not just the
in-process average. A live screenshot during =1 showed ordinary
vanilla content (sunset sky, sun, selection wireframe, hotbar) with no
trace of the magenta clear color anywhere on screen either.

Likely root cause: InteropHandles.java never calls
glMemoryObjectParameterivEXT(..., GL_DEDICATED_MEMORY_OBJECT_EXT,
GL_TRUE) before glImportMemoryFdEXT, but the exported Vulkan image is
a dedicated allocation (DxvkImage forces
dedicatedRequirements.requiresDedicatedAllocation when shared). Per
the GL_EXT_memory_object spec, importing a dedicated allocation
without marking the GL memory object dedicated first is undefined
behavior; reading back as zero is the documented NVIDIA driver
symptom. This is the one concrete difference from the standalone C
test earlier this session (tests/interop_gl.c), which does set this
parameter and reads back correctly. Not fixed this session per
instruction; TextureOverlay.render() and InteropTextureDumper both
read the same texture (GlInterop.getTexture()/colorImage.texture), so
this is not a "wrong image" mismatch.

Also added: RemixRenderer.diagLogOncePerSecond -- a once/second log of
camera position, forward vector, light count, loaded chunk count, and
whether Submit/Present were called that second. Live result: camera
valid, lights=2, chunks=128, Submit and Present called every frame --
the scene is being submitted continuously and correctly.

Separately found live (not related to the interop image, found while
bisecting): RemixWeatherRenderer.render() throws an uncaught
IllegalStateException("Remix depth texture is unavailable") and
crashes the whole client whenever it's raining, since the Linux
runtime's depth interop is unconditionally unavailable
(depthImageMemory_Handle == 0, Phase D step 5). Reproduced twice.
Worked around for testing by editing the save's level.dat (raining/
thundering NBT fields) with nbtlib, then restored the original values
afterward; not fixed in code.

debugView lookup (rtx.debugView.debugViewIdx, env
DXVK_RTX_DEBUG_VIEW_INDEX, quoted from dxvk-remix src/dxvk/rtx_render/
rtx_debug_view.h and src/dxvk/shaders/rtx/utility/debug_view_indices.h)
and a clean-run remix-dxvk.log grep for anything after "Spatially
Hashed Radiance Cache - activated" are in the session report, not
code: under default (non-overridden) shader compilation settings, that
line and the RenderPass setup lines never appeared at all in this log,
even 45+ seconds into real gameplay with chunks=128/lights=2 confirmed
submitting -- consistent with injectRTX's async-shader-compile skip
(Phase D step 5) still being in play in the full game, not just the
earlier synthetic test.

InteropTextureDumper's schedule is restored to 30s/2min/5min (shortened
to 2s/5s/10s during this session's fast-iteration bisection).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Signed-off-by: Kush J <kushisthecoolest@gmail.com>
---
 .../rtxremix/minecraft/RemixRenderer.java     | 24 +++++++++++++++++++
 .../minecraft/gl/InteropTextureDumper.java    | 20 +++++++++-------
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/src/main/java/com/nvidia/rtxremix/minecraft/RemixRenderer.java b/src/main/java/com/nvidia/rtxremix/minecraft/RemixRenderer.java
index d5fcd59..f691a54 100644
--- a/src/main/java/com/nvidia/rtxremix/minecraft/RemixRenderer.java
+++ b/src/main/java/com/nvidia/rtxremix/minecraft/RemixRenderer.java
@@ -1253,6 +1253,8 @@ public class RemixRenderer {
     
             remixApi.setupCamera(worldCameraInfo);
             remixApi.setupCamera(viewModelCameraInfo);
+            // TEMP DEBUG (not committed): once/second summary of what is being submitted to Remix.
+            diagLogOncePerSecond(pos, forwardX, forwardY, forwardZ);
             float viewDistanceStrength = viewDistanceFade.layerStrength(ClientViewDistance.chunks());
             updateCameraMedium(camera, pos, viewDistanceStrength, tickDelta);
         } catch (RemixException e) {
@@ -1323,8 +1325,29 @@ public class RemixRenderer {
         }
     }
     
+    // TEMP DEBUG fields (not committed): once-per-second submission summary.
+    private long diagLastLogNanos = 0;
+    private boolean diagSubmitCalled = false;
+    private boolean diagPresentCalled = false;
+
+    private void diagLogOncePerSecond(Vec3d pos, float fx, float fy, float fz) {
+        long now = System.nanoTime();
+        if (diagLastLogNanos != 0 && now - diagLastLogNanos < 1_000_000_000L) {
+            return;
+        }
+        diagLastLogNanos = now;
+        int lightCount = lightManager != null ? lightManager.getLightCount() : -1;
+        int chunkCount = chunkManager != null ? chunkManager.getLoadedChunkCount() : -1;
+        LOGGER.error(
+                "DIAG camera pos=({}, {}, {}) forward=({}, {}, {}) lights={} chunks={} submitCalled={} presentCalled={}",
+                pos.x, pos.y, pos.z, fx, fy, fz, lightCount, chunkCount, diagSubmitCalled, diagPresentCalled);
+        diagSubmitCalled = false;
+        diagPresentCalled = false;
+    }
+
     private void submitFrame() {
         remixApi.submit(null);
+        diagSubmitCalled = true;
     }
     
     /**
@@ -1336,6 +1359,7 @@ public class RemixRenderer {
      */
     public void presentFrameVk() {
         boolean failed = false;
+        diagPresentCalled = true;
         try {
             try (ProfileScope ignored = ProfileScope.begin("Interop.GLToVK")) {
                 blitGlToRemix();
diff --git a/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropTextureDumper.java b/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropTextureDumper.java
index 1ce9b0c..670f3b1 100644
--- a/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropTextureDumper.java
+++ b/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropTextureDumper.java
@@ -23,31 +23,33 @@ import static org.lwjgl.opengl.GL45.glGetTextureLevelParameteri;
  */
 public final class InteropTextureDumper {
     private static final Logger LOGGER = LoggerFactory.getLogger(InteropTextureDumper.class);
+    private static final long[] SCHEDULE_NANOS = { 30_000_000_000L, 120_000_000_000L, 300_000_000_000L };
     private static long firstSeenNanos = 0;
-    private static boolean dumped = false;
+    private static int nextScheduleIndex = 0;
 
     private InteropTextureDumper() {}
 
     /**
-     * Call once per frame with the current Remix output texture; dumps once, a fixed wall-clock
-     * delay after the texture first appears (NOT frame count: startup can run at very low FPS
-     * while shaders compile and large textures stream in synchronously, so a frame-count-based
-     * delay can fire mid-stall and catch a transient black frame).
+     * Call once per frame with the current Remix output texture; dumps at each point in
+     * SCHEDULE_NANOS after the texture first appears (NOT frame count: startup can run at very
+     * low FPS while shaders compile and large textures stream in synchronously, so a
+     * frame-count-based delay can fire mid-stall and catch a transient black frame).
      */
     public static void maybeDump(int textureId) {
-        if (dumped || textureId <= 0) {
+        if (nextScheduleIndex >= SCHEDULE_NANOS.length || textureId <= 0) {
             return;
         }
         long now = System.nanoTime();
         if (firstSeenNanos == 0) {
             firstSeenNanos = now;
         }
-        if (now - firstSeenNanos < 15_000_000_000L) { // 15 real seconds
+        if (now - firstSeenNanos < SCHEDULE_NANOS[nextScheduleIndex]) {
             return;
         }
-        dumped = true;
+        int index = nextScheduleIndex;
+        nextScheduleIndex++;
         try {
-            dump(textureId, "/mnt/big/remix-test/interop-dump.ppm");
+            dump(textureId, "/mnt/big/remix-test/interop-dump-" + (index + 1) + ".ppm");
         } catch (Exception e) {
             LOGGER.error("InteropTextureDumper: dump failed", e);
         }
