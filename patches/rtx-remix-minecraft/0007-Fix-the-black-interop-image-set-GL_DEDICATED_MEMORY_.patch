From 6e8a68d30f8002b320b51325b41ecaecfbbc21d4 Mon Sep 17 00:00:00 2001
From: Kush J <kushisthecoolest@gmail.com>
Date: Wed, 28 Oct 2026 17:18:09 -0500
Subject: [PATCH] Fix the black interop image: set
 GL_DEDICATED_MEMORY_OBJECT_EXT before import

InteropHandles.importMemory() never called
glMemoryObjectParameterivEXT(memoryObject, GL_DEDICATED_MEMORY_OBJECT_EXT,
GL_TRUE) before glImportMemoryFdEXT, but the Vulkan image Remix exports
is a dedicated allocation. Per the GL_EXT_memory_object spec that
omission is undefined behavior; tests/interop_gl.c (the known-good
reference) sets it. Verified live on the RTX 5070: the interop color
texture now reads back with real content (avg=13.2/88.9/93.0,
max=142/255/248 across the 30s/2min/5min dumps) instead of pure black,
and interop-dump-{1,2,3}.ppm all show genuine path-traced geometry
(soft shadows, GI, denoiser grain) through the real GL import path, not
a debug clear.

Also fixes the crash found in the prior bisection session (see
0006-*): raining on Linux (no depth interop image, see KNOWN_GAPS.md)
threw an uncaught IllegalStateException out of
RemixWeatherRenderer.render() and crashed the client. It now logs once
and skips weather for the frame instead.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Signed-off-by: Kush J <kushisthecoolest@gmail.com>
---
 .../nvidia/rtxremix/minecraft/gl/InteropHandles.java   |  5 +++++
 .../minecraft/weather/RemixWeatherRenderer.java        | 10 +++++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropHandles.java b/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropHandles.java
index cdc1856..17711e1 100644
--- a/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropHandles.java
+++ b/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropHandles.java
@@ -9,8 +9,10 @@ import org.lwjgl.opengl.GL11;
 import org.lwjgl.opengl.GLCapabilities;
 import org.lwjgl.system.Platform;
 
+import static org.lwjgl.opengl.EXTMemoryObject.GL_DEDICATED_MEMORY_OBJECT_EXT;
 import static org.lwjgl.opengl.EXTMemoryObject.GL_OPTIMAL_TILING_EXT;
 import static org.lwjgl.opengl.EXTMemoryObject.GL_TEXTURE_TILING_EXT;
+import static org.lwjgl.opengl.EXTMemoryObject.glMemoryObjectParameterivEXT;
 import static org.lwjgl.opengl.EXTMemoryObjectFD.GL_HANDLE_TYPE_OPAQUE_FD_EXT;
 import static org.lwjgl.opengl.EXTMemoryObjectFD.glImportMemoryFdEXT;
 import static org.lwjgl.opengl.EXTMemoryObjectWin32.GL_HANDLE_TYPE_OPAQUE_WIN32_EXT;
@@ -83,6 +85,9 @@ public final class InteropHandles {
     static void importMemory(int memoryObject, long allocationSize, long handle) {
         if (POSIX_FD) {
             int fd = toFd(handle);
+            // The imported image is a dedicated Vulkan allocation; EXT_external_objects requires
+            // this flag set before import for such allocations, as in tests/interop_gl.c.
+            glMemoryObjectParameterivEXT(memoryObject, GL_DEDICATED_MEMORY_OBJECT_EXT, new int[] {GL11.GL_TRUE});
             glImportMemoryFdEXT(memoryObject, allocationSize, GL_HANDLE_TYPE_OPAQUE_FD_EXT, fd);
             closeOnGlError(fd, "image memory");
         } else {
