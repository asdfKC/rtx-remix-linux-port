+// CMake build of the JNI bridge for Linux (rtxremix-java/native/CMakeLists.txt).
+// Writes build/native/linux64/libremixbridge.so, beside the Windows outputs.
+tasks.register('compileNativeLinux64') {
+    description = 'Compiles libremixbridge.so for Linux x86_64 with CMake'
+    group = 'build'
+    def sourceDir = file('rtxremix-java/native')
+    def cmakeBuildDir = file('build/native-cmake/linux64')
+    def outputDir = file('build/native/linux64')
+    // CMake finds jni.h through JAVA_HOME: the JDK running Gradle.
+    def javaHome = System.getProperty('java.home')
+    inputs.files file('rtxremix-java/native/CMakeLists.txt'),
+                 file('rtxremix-java/native/remixbridge.cpp'),
+                 file('rtxremix-java/native/include/remix_c.h')
+    outputs.file new File(outputDir, 'libremixbridge.so')
+    doLast {
+        runtimeFetchServices.execOperations.exec {
+            environment 'JAVA_HOME', javaHome
+            commandLine 'cmake', '-S', sourceDir.absolutePath, '-B', cmakeBuildDir.absolutePath,
+                    '-DCMAKE_BUILD_TYPE=RelWithDebInfo', "-DREMIXBRIDGE_OUTPUT_DIR=${outputDir.absolutePath}"
+        }
+        runtimeFetchServices.execOperations.exec {
+            commandLine 'cmake', '--build', cmakeBuildDir.absolutePath
+        }
+    }
+}
+
 jar {
     from("LICENSE") {
         rename { "${it}_${projectArchiveName}" }
@@ -497,6 +613,7 @@ def packageJarTask = tasks.register('packageJar', Zip) {
