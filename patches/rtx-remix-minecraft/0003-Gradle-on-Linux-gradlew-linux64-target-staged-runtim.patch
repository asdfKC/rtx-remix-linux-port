+    onlyIf { !isLinuxHost }
     commandLine 'powershell', '-NoProfile', '-ExecutionPolicy', 'Bypass',
             '-File', file('packaging/migrate_resource_packs.ps1').absolutePath,
             '-McDir', file('run').absolutePath, '-LegacyPackName', 'rtx-remix'
@@ -472,6 +562,32 @@ tasks.register('compileNativeArm64', Exec) {
