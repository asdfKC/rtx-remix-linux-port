     doFirst {
@@ -399,6 +486,9 @@ def syncRuntimeTexturesTask = tasks.register('syncRuntimeTextures', Sync) {
 }
 
 def migrateDevelopmentResourcePacksTask = tasks.register('migrateDevelopmentResourcePacks', Exec) {
+    // Migrates legacy baseline packs that only Windows development setups ever
