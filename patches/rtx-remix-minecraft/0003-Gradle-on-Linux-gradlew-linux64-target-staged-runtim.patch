+// On a Linux host the only target is linux64 (the native Linux runtime and
+// libremixbridge.so), and it is the default.
+def isLinuxHost = System.getProperty('os.name').toLowerCase(Locale.ROOT).startsWith('linux')
+def allArches = ['win64', 'arm64', 'linux64']
+def hostArches = isLinuxHost ? ['linux64'] : ['win64', 'arm64']
+def archProperty = project.findProperty('arch') ?: (isLinuxHost ? 'linux64' : null)
+if (archProperty && !(archProperty in hostArches)) {
+    throw new GradleException(isLinuxHost
+        ? "Invalid -Parch value on Linux: '${archProperty}'. Use linux64 (the default)."
+        : "Invalid -Parch value: '${archProperty}'. Use win64 or arm64 " +
+          "(or omit for dual-arch fat JAR).")
 }
 def buildArches = archProperty ? [archProperty] : ['win64', 'arm64']
 def isSingleArchJar = archProperty != null
@@ -250,10 +256,17 @@ tasks.withType(JavaCompile).configureEach {
     options.release = 21
 }
 
-def currentRuntimeArch = System.getProperty("os.arch") == "aarch64" ? "arm64" : "win64"
+def currentRuntimeArch = isLinuxHost ? "linux64"
+        : (System.getProperty("os.arch") == "aarch64" ? "arm64" : "win64")
 def runtimeArch = archProperty ?: currentRuntimeArch
 def runtimeSdkDir = "remix-runtime/${runtimeArch}"
 def runtimeBridgeDir = "build/native/${runtimeArch}"
+// The JNI bridge each target builds, and the task that builds it.
+def bridgeFilesFor = { arch -> arch == 'linux64' ? ['libremixbridge.so'] : ['remixbridge.dll', 'remixbridge.pdb'] }
+def runtimeLibraryFor = { arch -> arch == 'linux64' ? 'libremix.so' : 'd3d9.dll' }
+def compileNativeTaskFor = { arch ->
+    [win64: 'compileNativeWin64', arm64: 'compileNativeArm64', linux64: 'compileNativeLinux64'][arch]
+}
 
 // Fetch only the runtime consumed by each task. Existing directories, especially
 // local snapshots, belong to the developer; Gradle never replaces or updates them.
@@ -297,28 +310,96 @@ def fetchRuntimeSdkTasks = ['win64', 'arm64'].collectEntries { arch ->
     [(arch): fetchTask]
 }
 
+// There is no managed Linux runtime: remix-runtime/linux64 is staged from a
+// local dxvk-remix Linux build with stageLinuxRuntime. This task only checks.
+fetchRuntimeSdkTasks['linux64'] = tasks.register('fetchRuntimeSdkLinux64') {
+    description = 'Checks that a Linux runtime is staged in remix-runtime/linux64'
+    group = 'build'
+    def targetDir = file('remix-runtime/linux64')
+    doLast {
+        if (!new File(targetDir, 'libremix.so').file) {
+            throw new GradleException(
+                "No Linux runtime in ${targetDir}. Stage a local build first:\n" +
+                "  ./gradlew stageLinuxRuntime -PlinuxRuntime=<path to libremix.so or its directory>\n" +
+                "Optional: -PlinuxDlssDir=<dir with libnvidia-ngx-*.so.*> (default: the DLSS libraries\n" +
+                "of the dxvk-remix checkout the build came from, if they are found).")
+        }
+    }
+}
+
+// Copies a locally built libremix.so and the DLSS feature libraries beside it
+// into remix-runtime/linux64, and records where they came from. Explicit and
+// user-invoked: it replaces the staged files every time it runs.
+def linuxRuntimeProperty = providers.gradleProperty('linuxRuntime')
+def linuxDlssDirProperty = providers.gradleProperty('linuxDlssDir')
+tasks.register('stageLinuxRuntime') {
+    description = 'Stages a local Linux runtime: -PlinuxRuntime=<libremix.so or its dir> [-PlinuxDlssDir=<dir>]'
+    group = 'build setup'
+    def targetDir = file('remix-runtime/linux64')
+    doLast {
+        if (!linuxRuntimeProperty.isPresent()) {
+            throw new GradleException('Pass -PlinuxRuntime=<path to libremix.so or the directory that holds it>')
+        }
+        def runtime = new File(linuxRuntimeProperty.get())
+        if (runtime.directory) runtime = new File(runtime, 'libremix.so')
+        if (!runtime.file) {
+            throw new GradleException("libremix.so not found at ${runtime}")
+        }
+        // A build directory layout from scripts/build-runtime.sh: <work>/build/src/d3d9/libremix.so
+        // beside <work>/dxvk-remix/submodules/dlss/lib/Linux_x86_64/rel.
+        def dlssDir = linuxDlssDirProperty.isPresent()
+                ? new File(linuxDlssDirProperty.get())
+                : new File(runtime.parentFile, '../../../dxvk-remix/submodules/dlss/lib/Linux_x86_64/rel').canonicalFile
+        def targetPath = targetDir.toPath()
+        if (java.nio.file.Files.isSymbolicLink(targetPath)) {
+            throw new GradleException("${targetDir} is a link; remove it before staging a local runtime")
+        }
+        java.nio.file.Files.createDirectories(targetPath)
+        def copyIn = { File source ->
+            java.nio.file.Files.copy(source.toPath(), targetPath.resolve(source.name),
+                    java.nio.file.StandardCopyOption.REPLACE_EXISTING)
+            logger.lifecycle("Staged ${source.name}")
+        }
+        copyIn(runtime)
+        def dlssLibraries = dlssDir.directory
+                ? (dlssDir.listFiles().findAll { it.file && it.name ==~ /libnvidia-ngx-.*\.so.*/ } ?: [])
+                : []
+        if (dlssLibraries.isEmpty()) {
+            logger.warn("No DLSS libraries found in ${dlssDir}; DLSS stays unavailable. Pass -PlinuxDlssDir to stage them.")
+        }
+        dlssLibraries.each { copyIn(it) }
+        new File(targetDir, '.local-sdk-source').text =
+                "source: ${runtime.canonicalPath}\n" +
+                "dlss: ${dlssLibraries.isEmpty() ? '(none)' : dlssDir.canonicalPath}\n" +
+                "staged_at_utc: ${java.time.Instant.now()}\n"
+    }
+}
+
 // Dev run/ keeps full SDK contents including PDBs so debugger sessions against
 // a locally-built (possibly debug-flavor) dxvk can resolve symbols. packageJar
 // still strips SDK PDBs for distribution. Bridge copies inside the SDK directory
 // stay excluded so the freshly-built build/native/{arch} copy wins.
 def syncRuntimeSdkTask = tasks.register('syncRuntimeSdk', Sync) {
     dependsOn fetchRuntimeSdkTasks[runtimeArch]
-    dependsOn runtimeArch == "arm64" ? 'compileNativeArm64' : 'compileNativeWin64'
+    dependsOn compileNativeTaskFor(runtimeArch)
     doFirst {
         // Sync treats a missing `from` dir as empty and would silently strip
         // run/remix-sdk down to just the bridge DLL. Fail with the fix instead.
         if (!file(runtimeSdkDir).directory) {
-            throw new GradleException(
-                "Remix SDK directory '${runtimeSdkDir}' is missing. To use a local runtime override:\n" +
-                "  .\\tools\\rtx.bat sdk local --arch ${runtimeArch} --path <dir>\n" +
-                "docs/GETTING_STARTED.md#get-a-runtime describes local staging.")
+            throw new GradleException(isLinuxHost
+                ? "Remix SDK directory '${runtimeSdkDir}' is missing. Stage a local Linux runtime:\n" +
+                  "  ./gradlew stageLinuxRuntime -PlinuxRuntime=<path to libremix.so>"
+                : "Remix SDK directory '${runtimeSdkDir}' is missing. To use a local runtime override:\n" +
+                  "  .\\tools\\rtx.bat sdk local --arch ${runtimeArch} --path <dir>\n" +
+                  "docs/GETTING_STARTED.md#get-a-runtime describes local staging.")
         }
     }
     from(runtimeSdkDir) {
-        exclude 'remixbridge.dll', 'remixbridge.pdb'
+        exclude bridgeFilesFor(runtimeArch)
+        exclude '.local-sdk-source'
     }
     from(runtimeBridgeDir) {
-        include 'remixbridge.dll', 'remixbridge.pdb'
+        include bridgeFilesFor(runtimeArch)
     }
     into 'run/remix-sdk'
 }
@@ -361,7 +442,13 @@ def fetchRuntimeTexturesTask = tasks.register('fetchRuntimeTextures', Exec) {
     // spaces, and cmd skips the current folder for a bare name when
     // NoDefaultCurrentDirectoryInExePath is set.
     workingDir file('packman')
-    commandLine 'cmd', '/d', '/c', '.\\packman.cmd', 'pull', manifest.absolutePath
+    if (isLinuxHost) {
