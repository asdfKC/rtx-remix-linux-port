+            into("native/remix-sdk-linux64")
+            include "libremixbridge.so"
+        }
+    }
 
     from("packaging/rtx.conf") {
         into("native")
@@ -578,9 +706,8 @@ def verifyPackageJarTask = tasks.register('verifyPackageJar') {
         try {
             def required = ['META-INF/MANIFEST.MF', 'fabric.mod.json', 'native/rtx.conf']
             buildArches.each { arch ->
-                required.add("native/remix-sdk-${arch}/d3d9.dll")
-                required.add("native/remix-sdk-${arch}/remixbridge.dll")
-                required.add("native/remix-sdk-${arch}/remixbridge.pdb")
+                required.add("native/remix-sdk-${arch}/${runtimeLibraryFor(arch)}")
+                bridgeFilesFor(arch).each { required.add("native/remix-sdk-${arch}/${it}") }
             }
