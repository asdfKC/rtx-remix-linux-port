diff --git a/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropTextureDumper.java b/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropTextureDumper.java
new file mode 100644
index 0000000..429ee3a
--- /dev/null
+++ b/src/main/java/com/nvidia/rtxremix/minecraft/gl/InteropTextureDumper.java
@@ -0,0 +1,126 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.nvidia.rtxremix.minecraft.gl;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+
+import static org.lwjgl.opengl.GL11.*;
+import static org.lwjgl.opengl.GL30.*;
+import static org.lwjgl.opengl.GL45.glGetTextureLevelParameteri;
+
+/**
+ * Optional Linux bring-up diagnostics, off unless {@code REMIX_LINUX_DIAGNOSTICS=1}:
+ * dumps the Remix interop color texture to PPM files at 30 s, 2 min and 5 min
+ * after it first appears, so Remix's raw output can be inspected independently
+ * of whatever composites it on screen. Files go to {@code REMIX_LINUX_DIAG_DIR},
+ * default {@code remix-diagnostics/} in the game directory. RemixRenderer also
+ * logs a once-per-second submission summary while enabled.
+ */
+public final class InteropTextureDumper {
+    private static final Logger LOGGER = LoggerFactory.getLogger(InteropTextureDumper.class);
+    /** Whether the Linux diagnostics are on for this process. */
+    public static final boolean ENABLED = "1".equals(System.getenv("REMIX_LINUX_DIAGNOSTICS"));
+    private static final String DUMP_DIR = System.getenv("REMIX_LINUX_DIAG_DIR") != null
+            ? System.getenv("REMIX_LINUX_DIAG_DIR") : "remix-diagnostics";
+    private static final long[] SCHEDULE_NANOS = { 30_000_000_000L, 120_000_000_000L, 300_000_000_000L };
+    private static long firstSeenNanos = 0;
+    private static int nextScheduleIndex = 0;
+
+    private InteropTextureDumper() {}
+
+    /**
+     * Call once per frame with the current Remix output texture; dumps at each point in
+     * SCHEDULE_NANOS after the texture first appears (NOT frame count: startup can run at very
+     * low FPS while shaders compile and large textures stream in synchronously, so a
+     * frame-count-based delay can fire mid-stall and catch a transient black frame).
+     */
+    public static void maybeDump(int textureId) {
+        if (!ENABLED || nextScheduleIndex >= SCHEDULE_NANOS.length || textureId <= 0) {
+            return;
+        }
+        long now = System.nanoTime();
+        if (firstSeenNanos == 0) {
+            firstSeenNanos = now;
+        }
+        if (now - firstSeenNanos < SCHEDULE_NANOS[nextScheduleIndex]) {
+            return;
+        }
+        int index = nextScheduleIndex;
+        nextScheduleIndex++;
+        try {
+            java.nio.file.Files.createDirectories(java.nio.file.Path.of(DUMP_DIR));
+            dump(textureId, java.nio.file.Path.of(DUMP_DIR, "interop-dump-" + (index + 1) + ".ppm").toString());
+        } catch (Exception e) {
+            LOGGER.error("InteropTextureDumper: dump failed", e);
+        }
+    }
+
+    private static void dump(int textureId, String path) throws IOException {
+        // DSA variant: operates on the named texture directly, no bind required
+        // (glGetTexLevelParameteri reads whatever happens to be bound to GL_TEXTURE_2D,
+        // which at this call site -- before TextureOverlay binds this texture -- is not it).
+        int width = glGetTextureLevelParameteri(textureId, 0, GL_TEXTURE_WIDTH);
+        int height = glGetTextureLevelParameteri(textureId, 0, GL_TEXTURE_HEIGHT);
+        if (width <= 0 || height <= 0) {
+            LOGGER.error("InteropTextureDumper: bad texture size {}x{}", width, height);
+            return;
+        }
+
+        int fbo = glGenFramebuffers();
+        int prevReadFbo = glGetInteger(GL_READ_FRAMEBUFFER_BINDING);
+        int prevDrawFbo = glGetInteger(GL_DRAW_FRAMEBUFFER_BINDING);
+        glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textureId, 0);
+        int status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        if (status != GL_FRAMEBUFFER_COMPLETE) {
+            LOGGER.error("InteropTextureDumper: FBO incomplete, status=0x{}", Integer.toHexString(status));
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, prevReadFbo);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prevDrawFbo);
+            glDeleteFramebuffers(fbo);
+            return;
+        }
+
+        ByteBuffer pixels = ByteBuffer.allocateDirect(width * height * 4);
+        glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, prevReadFbo);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prevDrawFbo);
+        glDeleteFramebuffers(fbo);
+
+        long sum = 0;
+        int min = 255, max = 0;
+        for (int i = 0; i < width * height * 4; i += 4) {
+            for (int c = 0; c < 3; c++) {
+                int v = pixels.get(i + c) & 0xFF;
+                sum += v;
+                if (v < min) min = v;
+                if (v > max) max = v;
+            }
+        }
+        double avg = (double) sum / ((double) width * height * 3);
+        LOGGER.info("InteropTextureDumper: texture={} {}x{} avg={} min={} max={}",
+                textureId, width, height, avg, min, max);
+
+        try (FileOutputStream out = new FileOutputStream(path)) {
+            out.write(("P6\n" + width + " " + height + "\n255\n").getBytes());
+            byte[] row = new byte[width * 3];
+            for (int y = height - 1; y >= 0; y--) {
+                for (int x = 0; x < width; x++) {
+                    int srcIndex = (y * width + x) * 4;
+                    row[x * 3] = pixels.get(srcIndex);
+                    row[x * 3 + 1] = pixels.get(srcIndex + 1);
+                    row[x * 3 + 2] = pixels.get(srcIndex + 2);
+                }
+                out.write(row);
+            }
+        }
+        LOGGER.info("InteropTextureDumper: wrote {}", path);
+    }
+}
