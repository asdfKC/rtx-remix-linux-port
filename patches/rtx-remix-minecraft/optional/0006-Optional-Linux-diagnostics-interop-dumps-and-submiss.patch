+    // Optional Linux diagnostics (REMIX_LINUX_DIAGNOSTICS=1): once-per-second submission summary.
+    private long diagLastLogNanos = 0;
+    private boolean diagSubmitCalled = false;
+    private boolean diagPresentCalled = false;
+
+    private void diagLogOncePerSecond(Vec3d pos, float fx, float fy, float fz) {
+        long now = System.nanoTime();
+        if (diagLastLogNanos != 0 && now - diagLastLogNanos < 1_000_000_000L) {
+            return;
+        }
+        diagLastLogNanos = now;
+        int lightCount = lightManager != null ? lightManager.getLightCount() : -1;
+        int chunkCount = chunkManager != null ? chunkManager.getLoadedChunkCount() : -1;
+        LOGGER.info(
+                "DIAG camera pos=({}, {}, {}) forward=({}, {}, {}) lights={} chunks={} submitCalled={} presentCalled={}",
+                pos.x, pos.y, pos.z, fx, fy, fz, lightCount, chunkCount, diagSubmitCalled, diagPresentCalled);
+        diagSubmitCalled = false;
+        diagPresentCalled = false;
+    }
+
     private void submitFrame() {
         remixApi.submit(null);
+        diagSubmitCalled = true;
     }
     
